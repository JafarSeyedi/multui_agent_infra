{
  "name": "pair_programming_workflow",
  "version": "2.0",
  "description": "Complete pair programming workflow - collaborative coding sessions between humans and AI agents with role switching, code review, knowledge transfer, and quality assurance",
  
  "variables": {
    "session_config": {
      "roles": ["driver", "navigator"],
      "current_role": "driver",
      "role_swap_interval_minutes": 25,
      "last_swap_time": null,
      "total_pairs": 0
    },
    "session_state": {
      "status": "pending",
      "current_file": null,
      "current_line": 0,
      "focus_area": null,
      "blockers": []
    },
    "collaboration_metrics": {
      "code_contributions": {"human": 0, "ai": 0},
      "suggestions_made": 0,
      "suggestions_accepted": 0,
      "conflicts_resolved": 0,
      "knowledge_transfers": 0
    },
    "quality_checks": {
      "style_consistency": true,
      "test_coverage_target": 80,
      "review_required": true,
      "documentation_required": true
    },
    "session_duration_minutes": 0,
    "max_session_duration_minutes": 120,
    "current_iteration": 0,
    "max_iterations": 10
  },
  
  "tasks": [
    {
      "id": "initialize_session",
      "name": "Initialize Pair Programming Session",
      "type": "transform",
      "component": null,
      "method": null,
      "parameters": {
        "session_id": "{{input.session_id}}",
        "participants": {
          "human": "{{input.human_participant}}",
          "ai": "system"
        },
        "initial_role": "driver",
        "goal": "{{input.goal}}",
        "context": "{{input.context}}"
      },
      "timeout": 30
    },
    
    {
      "id": "setup_environment",
      "name": "Setup Pair Programming Environment",
      "type": "function",
      "component": null,
      "method": null,
      "parameters": {
        "workspace": "{{input.workspace_path}}",
        "create_branch": true,
        "branch_name": "pair/{{input.session_id}}",
        "setup_realtime_sync": true,
        "configure_editor": "{{input.editor}}"
      },
      "depends_on": ["initialize_session"],
      "timeout": 60
    },
    
    {
      "id": "load_context",
      "name": "Load Project Context",
      "type": "analysis",
      "component": "project_scanner",
      "method": "load_context",
      "parameters": {
        "project_path": "{{input.project_path}}",
        "load_files": ["{{input.target_files}}"],
        "load_dependencies": true,
        "load_tests": true,
        "load_documentation": true,
        "extract_symbols": true
      },
      "depends_on": ["setup_environment"],
      "timeout": 180
    },
    
    {
      "id": "analyze_current_codebase",
      "name": "Analyze Current Codebase State",
      "type": "analysis",
      "component": "ast_analyzer",
      "method": "analyze_codebase",
      "parameters": {
        "files": "{{load_context.output.files}}",
        "analyze_metrics": ["complexity", "coverage", "dependencies", "code_smells"],
        "identify_hotspots": true,
        "suggest_improvements": true
      },
      "depends_on": ["load_context"],
      "timeout": 120
    },
    
    {
      "id": "define_pairing_goal",
      "name": "Define Pair Programming Goal",
      "type": "human",
      "parameters": {
        "type": "interaction",
        "title": "Define Pair Programming Goal",
        "description": "Please define the specific goal for this pair programming session",
        "required_skills": ["programming", "communication"],
        "priority": 0,
        "timeout_minutes": 10,
        "data": {
          "current_state": "{{analyze_current_codebase.output.summary}}",
          "suggested_goals": "{{analyze_current_codebase.output.suggestions}}",
          "available_tasks": "{{input.available_tasks}}"
        },
        "interaction_type": "goal_setting"
      },
      "depends_on": ["analyze_current_codebase"]
    },
    
    {
      "id": "create_implementation_plan",
      "name": "Create Implementation Plan",
      "type": "generation",
      "component": "task_decomposer",
      "method": "create_implementation_plan",
      "parameters": {
        "goal": "{{define_pairing_goal.output.goal}}",
        "current_code": "{{load_context.output}}",
        "constraints": "{{input.constraints}}",
        "step_size": "small",
        "include_tests": true,
        "include_documentation": true
      },
      "depends_on": ["define_pairing_goal"],
      "timeout": 90
    },
    
    {
      "id": "human_review_plan",
      "name": "Human Review Implementation Plan",
      "type": "human",
      "parameters": {
        "type": "review",
        "title": "Review Implementation Plan",
        "description": "Please review the proposed implementation plan",
        "required_skills": ["code_review", "planning"],
        "priority": 1,
        "timeout_minutes": 15,
        "data": {
          "plan": "{{create_implementation_plan.output}}",
          "estimated_steps": "{{create_implementation_plan.output.steps.length}}",
          "estimated_duration": "{{create_implementation_plan.output.estimated_duration}}"
        },
        "approval_required": true
      },
      "depends_on": ["create_implementation_plan"]
    },
    
    {
      "id": "start_coding_iteration",
      "name": "Start Coding Iteration",
      "type": "transform",
      "component": null,
      "method": null,
      "parameters": {
        "iteration": "{{variables.current_iteration}}",
        "step": "{{create_implementation_plan.output.steps[variables.current_iteration]}}",
        "role": "{{variables.session_config.current_role}}",
        "start_time": "{{context.current_time}}"
      },
      "depends_on": ["human_review_plan"]
    },
    
    {
      "id": "driver_generates_code",
      "name": "Driver Generates/Modifies Code",
      "type": "generation",
      "component": "function_generator",
      "method": "generate_code",
      "parameters": {
        "task": "{{start_coding_iteration.output.step}}",
        "context": "{{load_context.output}}",
        "existing_code": "{{load_context.output.files_content}}",
        "style_guide": "{{input.style_guide}}",
        "include_comments": true,
        "include_type_hints": true,
        "role": "{{variables.session_config.current_role}}"
      },
      "depends_on": ["start_coding_iteration"],
      "timeout": 120
    },
    
    {
      "id": "navigator_reviews_code",
      "name": "Navigator Reviews Generated Code",
      "type": "quality",
      "component": "code_review_skill",
      "method": "review_code",
      "parameters": {
        "code": "{{driver_generates_code.output.code}}",
        "requirements": "{{start_coding_iteration.output.step.requirements}}",
        "review_focus": ["correctness", "style", "performance", "security"],
        "suggest_improvements": true
      },
      "depends_on": ["driver_generates_code"],
      "timeout": 90
    },
    
    {
      "id": "human_navigator_feedback",
      "name": "Human Navigator Provides Feedback",
      "type": "human",
      "parameters": {
        "type": "review",
        "title": "Navigator Review Feedback",
        "description": "Please provide feedback on the generated code",
        "required_skills": ["code_review", "critical_thinking"],
        "priority": 1,
        "timeout_minutes": 10,
        "data": {
          "code": "{{driver_generates_code.output.code}}",
          "ai_review": "{{navigator_reviews_code.output}}",
          "step_context": "{{start_coding_iteration.output.step}}"
        },
        "interaction_type": "code_review"
      },
      "depends_on": ["navigator_reviews_code"]
    },
    
    {
      "id": "discuss_changes",
      "name": "Discuss and Resolve Differences",
      "type": "human",
      "parameters": {
        "type": "interaction",
        "title": "Discuss Code Changes",
        "description": "Discuss the code changes and resolve any disagreements",
        "required_skills": ["communication", "collaboration"],
        "priority": 1,
        "timeout_minutes": 15,
        "data": {
          "ai_suggestion": "{{navigator_reviews_code.output.suggestions}}",
          "human_feedback": "{{human_navigator_feedback.output}}",
          "code_diff": "{{driver_generates_code.output.diff}}"
        },
        "interaction_type": "discussion"
      },
      "depends_on": ["human_navigator_feedback"]
    },
    
    {
      "id": "apply_changes",
      "name": "Apply Agreed Changes",
      "type": "refinement",
      "component": "iterative_refiner",
      "method": "apply_changes",
      "parameters": {
        "code": "{{driver_generates_code.output.code}}",
        "feedback": "{{discuss_changes.output.agreed_changes}}",
        "preserve_functionality": true,
        "update_tests": true
      },
      "depends_on": ["discuss_changes"],
      "timeout": 90
    },
    
    {
      "id": "run_quick_tests",
      "name": "Run Quick Tests",
      "type": "quality",
      "component": "test_runner",
      "method": "run_quick_tests",
      "parameters": {
        "test_files": "{{input.test_files}}",
        "target_files": "{{apply_changes.output.modified_files}}",
        "test_types": ["unit", "smoke"],
        "fail_fast": false,
        "timeout_per_test": 5
      },
      "depends_on": ["apply_changes"],
      "timeout": 60
    },
    
    {
      "id": "check_test_pass",
      "name": "Check Test Results",
      "type": "condition",
      "component": null,
      "method": null,
      "parameters": {
        "test_results": "{{run_quick_tests.output}}",
        "required_pass_rate": 100,
        "required_tests_passed": "{{run_quick_tests.output.summary.passed}}"
      },
      "depends_on": ["run_quick_tests"]
    },
    
    {
      "id": "fix_test_failures",
      "name": "Fix Test Failures",
      "type": "refinement",
      "component": "feedback_loop",
      "method": "fix_test_failures",
      "parameters": {
        "test_results": "{{run_quick_tests.output}}",
        "code": "{{apply_changes.output.code}}",
        "max_attempts": 3
      },
      "depends_on": ["check_test_pass"],
      "condition": "{{check_test_pass.output}} == false",
      "timeout": 120
    },
    
    {
      "id": "revalidate_after_fix",
      "name": "Revalidate After Fix",
      "type": "quality",
      "component": "test_runner",
      "method": "run_quick_tests",
      "parameters": {
        "files": "{{fix_test_failures.output.modified_files}}"
      },
      "depends_on": ["fix_test_failures"],
      "timeout": 60
    },
    
    {
      "id": "update_documentation",
      "name": "Update Documentation",
      "type": "generation",
      "component": "docstring_generator",
      "method": "update_documentation",
      "parameters": {
        "modified_files": "{{apply_changes.output.modified_files}}",
        "update_docstrings": true,
        "update_comments": true,
        "update_readme": "{{input.update_readme}}"
      },
      "depends_on": ["check_test_pass", "revalidate_after_fix"],
      "timeout": 60
    },
    
    {
      "id": "commit_progress",
      "name": "Commit Progress",
      "type": "function",
      "component": "git_utils",
      "method": "commit_changes",
      "parameters": {
        "files": "{{apply_changes.output.modified_files}}",
        "message": "Pair programming: {{start_coding_iteration.output.step.description}}",
        "co_authors": ["{{input.human_participant}}", "AI Assistant"],
        "sign_off": true
      },
      "depends_on": ["update_documentation"],
      "timeout": 30
    },
    
    {
      "id": "check_role_swap",
      "name": "Check if Role Swap Needed",
      "type": "condition",
      "component": null,
      "method": null,
      "parameters": {
        "time_since_swap": "{{context.current_time}} - {{variables.session_config.last_swap_time}}",
        "swap_interval": "{{variables.session_config.role_swap_interval_minutes}}",
        "should_swap": "{{time_since_swap}} >= {{swap_interval}}"
      },
      "depends_on": ["commit_progress"]
    },
    
    {
      "id": "swap_roles",
      "name": "Swap Driver/Navigator Roles",
      "type": "transform",
      "component": null,
      "method": null,
      "parameters": {
        "new_driver": "{{variables.session_config.current_role == 'driver' ? 'navigator' : 'driver'}}",
        "swap_announcement": "Role swap: {{variables.session_config.current_role}} becomes {{new_driver}}",
        "update_session": true,
        "record_swap_time": "{{context.current_time}}"
      },
      "depends_on": ["check_role_swap"],
      "condition": "{{check_role_swap.output}} == true"
    },
    
    {
      "id": "knowledge_transfer",
      "name": "Knowledge Transfer Session",
      "type": "human",
      "parameters": {
        "type": "interaction",
        "title": "Knowledge Transfer",
        "description": "Share context and insights before role swap",
        "required_skills": ["communication", "teaching"],
        "priority": 1,
        "timeout_minutes": 5,
        "data": {
          "current_state": "{{load_context.output.summary}}",
          "progress_summary": "{{commit_progress.output.summary}}",
          "pending_decisions": "{{discuss_changes.output.pending}}",
          "next_steps": "{{create_implementation_plan.output.remaining_steps}}"
        },
        "interaction_type": "knowledge_transfer"
      },
      "depends_on": ["swap_roles"]
    },
    
    {
      "id": "check_iteration_complete",
      "name": "Check if Iteration Complete",
      "type": "condition",
      "component": null,
      "method": null,
      "parameters": {
        "current_step": "{{variables.current_iteration}}",
        "total_steps": "{{create_implementation_plan.output.steps.length}}",
        "all_steps_complete": "{{current_step}} >= {{total_steps}}"
      },
      "depends_on": ["knowledge_transfer", "commit_progress"]
    },
    
    {
      "id": "increment_iteration",
      "name": "Increment Iteration Counter",
      "type": "transform",
      "component": null,
      "method": null,
      "parameters": {
        "operation": "increment",
        "variable": "current_iteration",
        "next_step": "{{create_implementation_plan.output.steps[variables.current_iteration + 1]}}"
      },
      "depends_on": ["check_iteration_complete"],
      "condition": "{{check_iteration_complete.output}} == false"
    },
    
    {
      "id": "loop_next_iteration",
      "name": "Continue to Next Iteration",
      "type": "transform",
      "component": null,
      "method": null,
      "parameters": {
        "goto": "start_coding_iteration",
        "updated_context": {
          "code": "{{apply_changes.output.code}}",
          "tests": "{{run_quick_tests.output}}",
          "documentation": "{{update_documentation.output}}"
        }
      },
      "depends_on": ["increment_iteration"]
    },
    
    {
      "id": "check_session_duration",
      "name": "Check Session Duration",
      "type": "condition",
      "component": null,
      "method": null,
      "parameters": {
        "session_duration": "{{variables.session_duration_minutes}}",
        "max_duration": "{{variables.max_session_duration_minutes}}",
        "should_end": "{{session_duration}} >= {{max_duration}}"
      },
      "depends_on": ["check_iteration_complete"],
      "condition": "{{check_iteration_complete.output}} == true"
    },
    
    {
      "id": "schedule_followup",
      "name": "Schedule Follow-up Session",
      "type": "human",
      "parameters": {
        "type": "interaction",
        "title": "Schedule Follow-up Session",
        "description": "The session time limit is approaching. Schedule a follow-up session?",
        "required_skills": ["planning"],
        "priority": 1,
        "timeout_minutes": 5,
        "data": {
          "completed_steps": "{{variables.current_iteration}}",
          "remaining_steps": "{{create_implementation_plan.output.remaining_steps}}",
          "session_duration": "{{variables.session_duration_minutes}}"
        },
        "interaction_type": "scheduling"
      },
      "depends_on": ["check_session_duration"],
      "condition": "{{check_session_duration.output}} == true and {{check_iteration_complete.output}} == false"
    },
    
    {
      "id": "run_full_test_suite",
      "name": "Run Full Test Suite",
      "type": "quality",
      "component": "test_runner",
      "method": "run_all_tests",
      "parameters": {
        "test_path": "{{input.test_path}}",
        "parallel": true,
        "coverage_report": true,
        "fail_fast": false
      },
      "depends_on": ["check_iteration_complete", "schedule_followup"],
      "condition": "{{check_iteration_complete.output}} == true",
      "timeout": 300
    },
    
    {
      "id": "calculate_coverage",
      "name": "Calculate Test Coverage",
      "type": "quality",
      "component": "coverage_analyzer",
      "method": "calculate_coverage",
      "parameters": {
        "source_files": "{{apply_changes.output.modified_files}}",
        "test_results": "{{run_full_test_suite.output}}",
        "coverage_type": "line_branch"
      },
      "depends_on": ["run_full_test_suite"],
      "timeout": 60
    },
    
    {
      "id": "check_coverage_threshold",
      "name": "Check Coverage Threshold",
      "type": "condition",
      "component": null,
      "method": null,
      "parameters": {
        "coverage": "{{calculate_coverage.output.percentage}}",
        "threshold": "{{variables.quality_checks.test_coverage_target}}",
        "meets_threshold": "{{coverage}} >= {{threshold}}"
      },
      "depends_on": ["calculate_coverage"]
    },
    
    {
      "id": "improve_coverage",
      "name": "Improve Test Coverage",
      "type": "generation",
      "component": "test_generator",
      "method": "generate_missing_tests",
      "parameters": {
        "uncovered_lines": "{{calculate_coverage.output.uncovered}}",
        "source_code": "{{apply_changes.output.code}}",
        "test_framework": "pytest"
      },
      "depends_on": ["check_coverage_threshold"],
      "condition": "{{check_coverage_threshold.output}} == false",
      "timeout": 120
    },
    
    {
      "id": "run_additional_tests",
      "name": "Run Additional Tests",
      "type": "quality",
      "component": "test_runner",
      "method": "run_tests",
      "parameters": {
        "test_files": "{{improve_coverage.output.test_files}}"
      },
      "depends_on": ["improve_coverage"],
      "timeout": 120
    },
    
    {
      "id": "code_quality_validation",
      "name": "Code Quality Validation",
      "type": "quality",
      "component": "ruff_validator",
      "method": "validate_quality",
      "parameters": {
        "files": "{{apply_changes.output.modified_files}}",
        "check_style": true,
        "check_complexity": true,
        "check_maintainability": true
      },
      "depends_on": ["run_full_test_suite", "run_additional_tests"],
      "timeout": 90
    },
    
    {
      "id": "generate_code_review",
      "name": "Generate Final Code Review",
      "type": "quality",
      "component": "code_review_skill",
      "method": "final_review",
      "parameters": {
        "files": "{{apply_changes.output.modified_files}}",
        "original_code": "{{load_context.output}}",
        "review_depth": "comprehensive",
        "checklist": [
          "functionality",
          "style_consistency",
          "error_handling",
          "performance",
          "security",
          "documentation",
          "test_coverage"
        ]
      },
      "depends_on": ["code_quality_validation"],
      "timeout": 180
    },
    
    {
      "id": "human_final_review",
      "name": "Human Final Review",
      "type": "human",
      "parameters": {
        "type": "review",
        "title": "Final Pair Programming Review",
        "description": "Please review the final code changes",
        "required_skills": ["code_review", "quality_assurance"],
        "priority": 0,
        "timeout_hours": 24,
        "data": {
          "code_changes": "{{apply_changes.output.diff}}",
          "test_results": "{{run_full_test_suite.output.summary}}",
          "coverage": "{{calculate_coverage.output}}",
          "quality_report": "{{code_quality_validation.output}}",
          "code_review": "{{generate_code_review.output}}",
          "collaboration_metrics": "{{variables.collaboration_metrics}}"
        },
        "approval_required": true,
        "allow_comments": true
      },
      "depends_on": ["generate_code_review"]
    },
    
    {
      "id": "create_pr",
      "name": "Create Pull Request",
      "type": "function",
      "component": "git_utils",
      "method": "create_pull_request",
      "parameters": {
        "branch": "pair/{{input.session_id}}",
        "title": "Pair Programming: {{define_pairing_goal.output.goal}}",
        "description": "Generated from pair programming session\n\nParticipants: {{input.human_participant}} and AI Assistant\n\nChanges:\n{{apply_changes.output.summary}}\n\nTest Results:\n{{run_full_test_suite.output.summary}}\n\nCoverage: {{calculate_coverage.output.percentage}}%",
        "reviewers": "{{input.reviewers}}",
        "labels": ["pair-programming", "ai-assisted"]
      },
      "depends_on": ["human_final_review"],
      "timeout": 60
    },
    
    {
      "id": "generate_session_report",
      "name": "Generate Pair Programming Report",
      "type": "generation",
      "component": null,
      "method": null,
      "parameters": {
        "workflow_name": "pair_programming_workflow",
        "session_id": "{{input.session_id}}",
        "duration": "{{variables.session_duration_minutes}}",
        "iterations": "{{variables.current_iteration}}",
        "metrics": {
          "code_contributions": "{{variables.collaboration_metrics.code_contributions}}",
          "suggestions": {
            "made": "{{variables.collaboration_metrics.suggestions_made}}",
            "accepted": "{{variables.collaboration_metrics.suggestions_accepted}}",
            "acceptance_rate": "{{variables.collaboration_metrics.suggestions_accepted / variables.collaboration_metrics.suggestions_made * 100}}"
          },
          "conflicts_resolved": "{{variables.collaboration_metrics.conflicts_resolved}}",
          "knowledge_transfers": "{{variables.collaboration_metrics.knowledge_transfers}}",
          "role_swaps": "{{variables.session_config.total_pairs}}"
        },
        "quality_metrics": {
          "test_pass_rate": "{{run_full_test_suite.output.pass_rate}}",
          "coverage": "{{calculate_coverage.output.percentage}}",
          "quality_score": "{{code_quality_validation.output.score}}",
          "maintainability": "{{code_quality_validation.output.maintainability}}"
        },
        "artifacts": {
          "branch": "pair/{{input.session_id}}",
          "pr_url": "{{create_pr.output.url}}",
          "commits": "{{commit_progress.output.commits}}"
        },
        "output_format": "html"
      },
      "depends_on": ["create_pr"],
      "timeout": 120
    },
    
    {
      "id": "notify_participants",
      "name": "Notify Session Participants",
      "type": "notify",
      "component": null,
      "method": null,
      "parameters": {
        "type": "workflow_completed",
        "message": "Pair programming session completed",
        "channels": ["slack", "email"],
        "recipients": ["{{input.human_participant}}", "{{input.reviewers}}"],
        "data": {
          "workflow": "pair_programming_workflow",
          "session_id": "{{input.session_id}}",
          "duration": "{{variables.session_duration_minutes}}",
          "goal": "{{define_pairing_goal.output.goal}}",
          "pr_url": "{{create_pr.output.url}}",
          "report_url": "{{generate_session_report.output.url}}",
          "summary": {
            "commits": "{{commit_progress.output.commits.length}}",
            "files_changed": "{{apply_changes.output.modified_files.length}}",
            "tests_passed": "{{run_full_test_suite.output.summary.passed}}",
            "coverage_gain": "{{calculate_coverage.output.improvement}}"
          }
        }
      },
      "depends_on": ["generate_session_report"]
    },
    
    {
      "id": "archive_session",
      "name": "Archive Session Data",
      "type": "transform",
      "component": null,
      "method": null,
      "parameters": {
        "session_data": {
          "config": "{{variables.session_config}}",
          "metrics": "{{variables.collaboration_metrics}}",
          "plan": "{{create_implementation_plan.output}}",
          "commits": "{{commit_progress.output.commits}}",
          "report": "{{generate_session_report.output}}"
        },
        "archive_location": "{{input.archive_path}}/pair_sessions/{{input.session_id}}",
        "retention_days": 90,
        "compress": true
      },
      "depends_on": ["notify_participants"]
    }
  ]
}
