{
  "name": "planning_workflow",
  "version": "3.0",
  "description": "Complete project planning workflow - requirement analysis, task decomposition, dependency mapping, resource allocation, timeline estimation, and risk assessment",
  
  "variables": {
    "planning_phases": {
      "requirements": {"status": "pending", "completed": false},
      "decomposition": {"status": "pending", "completed": false},
      "dependency_mapping": {"status": "pending", "completed": false},
      "estimation": {"status": "pending", "completed": false},
      "resource_allocation": {"status": "pending", "completed": false},
      "risk_assessment": {"status": "pending", "completed": false},
      "timeline": {"status": "pending", "completed": false},
      "approval": {"status": "pending", "completed": false}
    },
    "task_hierarchy": {},
    "dependency_graph": {},
    "critical_path": [],
    "resource_requirements": {},
    "risk_register": [],
    "milestones": [],
    "total_estimated_hours": 0,
    "planning_version": 1,
    "optimization_iterations": 0,
    "max_optimization_iterations": 3
  },
  
  "tasks": [
    {
      "id": "collect_requirements",
      "name": "Collect and Analyze Requirements",
      "type": "analysis",
      "component": "project_scanner",
      "method": "analyze_requirements",
      "parameters": {
        "requirement_sources": [
          "{{input.requirement_files}}",
          "{{input.user_stories}}",
          "{{input.specification_docs}}",
          "{{input.feedback_suggestions}}"
        ],
        "extract_acceptance_criteria": true,
        "identify_constraints": true,
        "prioritize_requirements": true
      },
      "timeout": 180
    },
    
    {
      "id": "validate_requirements",
      "name": "Validate Requirements Completeness",
      "type": "quality",
      "component": "architecture_validator",
      "method": "validate_requirements",
      "parameters": {
        "requirements": "{{collect_requirements.output.requirements}}",
        "validation_criteria": [
          "completeness",
          "consistency",
          "feasibility",
          "testability",
          "unambiguity"
        ],
        "min_completeness_score": 85
      },
      "depends_on": ["collect_requirements"],
      "timeout": 120
    },
    
    {
      "id": "human_review_requirements",
      "name": "Human Review: Requirements",
      "type": "human",
      "parameters": {
        "type": "review",
        "title": "Requirements Review",
        "description": "Please review the collected requirements and prioritization",
        "required_skills": ["requirements_analysis", "business_analysis", "domain_knowledge"],
        "priority": 0,
        "timeout_hours": 24,
        "data": {
          "requirements": "{{collect_requirements.output.requirements}}",
          "validation_results": "{{validate_requirements.output}}",
          "priorities": "{{collect_requirements.output.priorities}}",
          "gaps": "{{validate_requirements.output.gaps}}"
        },
        "approval_required": true,
        "allow_modifications": true
      },
      "depends_on": ["validate_requirements"]
    },
    
    {
      "id": "decompose_requirements",
      "name": "Decompose Requirements into Tasks",
      "type": "planning",
      "component": "task_decomposer",
      "method": "decompose_requirements",
      "parameters": {
        "requirements": "{{human_review_requirements.output.approved_requirements}}",
        "decomposition_strategy": "functional",
        "max_task_size_hours": 40,
        "min_task_size_hours": 2,
        "create_work_breakdown_structure": true
      },
      "depends_on": ["human_review_requirements"],
      "timeout": 300
    },
    
    {
      "id": "analyze_dependencies",
      "name": "Analyze Task Dependencies",
      "type": "planning",
      "component": "dependency_analyzer",
      "method": "analyze_dependencies",
      "parameters": {
        "tasks": "{{decompose_requirements.output.tasks}}",
        "dependency_types": ["functional", "data", "resource", "temporal"],
        "detect_circular_dependencies": true,
        "suggest_dependency_optimizations": true
      },
      "depends_on": ["decompose_requirements"],
      "timeout": 180
    },
    
    {
      "id": "build_dependency_graph",
      "name": "Build Dependency Graph",
      "type": "transform",
      "component": null,
      "method": null,
      "parameters": {
        "dependencies": "{{analyze_dependencies.output.dependencies}}",
        "tasks": "{{decompose_requirements.output.tasks}}",
        "graph_format": "directed_acyclic_graph",
        "identify_parallelizable_groups": true,
        "calculate_depth": true
      },
      "depends_on": ["analyze_dependencies"]
    },
    
    {
      "id": "identify_critical_path",
      "name": "Identify Critical Path",
      "type": "analysis",
      "component": "dependency_analyzer",
      "method": "find_critical_path",
      "parameters": {
        "dependency_graph": "{{build_dependency_graph.output.graph}}",
        "task_durations": "{{estimate_efforts.output.durations}}",
        "calculate_slack": true,
        "identify_bottlenecks": true
      },
      "depends_on": ["build_dependency_graph", "estimate_efforts"],
      "timeout": 120
    },
    
    {
      "id": "estimate_efforts",
      "name": "Estimate Task Efforts",
      "type": "planning",
      "component": "progress_tracker",
      "method": "estimate_efforts",
      "parameters": {
        "tasks": "{{decompose_requirements.output.tasks}}",
        "estimation_method": "three_point",
        "complexity_factors": ["technical", "integration", "testing", "documentation"],
        "use_historical_data": true,
        "confidence_level": 0.85
      },
      "depends_on": ["decompose_requirements"],
      "timeout": 180
    },
    
    {
      "id": "calculate_optimistic_pessimistic",
      "name": "Calculate Optimistic/Pessimistic Estimates",
      "type": "transform",
      "component": null,
      "method": null,
      "parameters": {
        "estimates": "{{estimate_efforts.output}}",
        "formula": {
          "expected": "(optimistic + 4 * most_likely + pessimistic) / 6",
          "variance": "((pessimistic - optimistic) / 6) ** 2"
        },
        "confidence_intervals": [68, 95, 99]
      },
      "depends_on": ["estimate_efforts"]
    },
    
    {
      "id": "identify_skill_requirements",
      "name": "Identify Skill Requirements per Task",
      "type": "analysis",
      "component": "skill_gap_analyzer",
      "method": "analyze_task_skills",
      "parameters": {
        "tasks": "{{decompose_requirements.output.tasks}}",
        "skill_categories": ["programming", "testing", "documentation", "devops", "security"],
        "proficiency_levels": ["novice", "beginner", "intermediate", "advanced", "expert"],
        "extract_from_task_description": true
      },
      "depends_on": ["decompose_requirements"],
      "timeout": 150
    },
    
    {
      "id": "check_resource_availability",
      "name": "Check Resource Availability",
      "type": "analysis",
      "component": "assignment_engine",
      "method": "get_available_resources",
      "parameters": {
        "skill_requirements": "{{identify_skill_requirements.output.skill_requirements}}",
        "current_workloads": true,
        "availability_window": "{{input.timeline_start}} to {{input.timeline_end}}",
        "include_planned_vacations": true
      },
      "depends_on": ["identify_skill_requirements"],
      "timeout": 120
    },
    
    {
      "id": "allocate_resources",
      "name": "Allocate Resources to Tasks",
      "type": "planning",
      "component": "assignment_engine",
      "method": "optimize_assignment",
      "parameters": {
        "tasks": "{{decompose_requirements.output.tasks}}",
        "available_resources": "{{check_resource_availability.output.resources}}",
        "skill_requirements": "{{identify_skill_requirements.output.skill_requirements}}",
        "optimization_goals": ["minimize_duration", "balance_workload", "maximize_skill_match"],
        "constraints": {
          "max_concurrent_tasks_per_resource": 3,
          "max_hours_per_day": 6,
          "work_days": ["monday", "tuesday", "wednesday", "thursday", "friday"]
        }
      },
      "depends_on": ["check_resource_availability"],
      "timeout": 300
    },
    
    {
      "id": "create_timeline",
      "name": "Create Project Timeline",
      "type": "transform",
      "component": null,
      "method": null,
      "parameters": {
        "tasks": "{{decompose_requirements.output.tasks}}",
        "dependencies": "{{analyze_dependencies.output.dependencies}}",
        "allocations": "{{allocate_resources.output.allocations}}",
        "estimates": "{{estimate_efforts.output}}",
        "start_date": "{{input.timeline_start}}",
        "working_hours_per_day": 8,
        "include_buffers": true,
        "buffer_percentage": 15
      },
      "depends_on": ["allocate_resources", "identify_critical_path"],
      "timeout": 180
    },
    
    {
      "id": "identify_milestones",
      "name": "Identify Key Milestones",
      "type": "transform",
      "component": null,
      "method": null,
      "parameters": {
        "timeline": "{{create_timeline.output.timeline}}",
        "critical_path": "{{identify_critical_path.output.path}}",
        "milestone_types": [
          "requirements_complete",
          "design_approval",
          "implementation_complete",
          "testing_complete",
          "deployment_ready"
        ],
        "auto_detect_milestones": true
      },
      "depends_on": ["create_timeline"]
    },
    
    {
      "id": "assess_risks",
      "name": "Assess Project Risks",
      "type": "analysis",
      "component": "impact_analyzer",
      "method": "assess_risks",
      "parameters": {
        "tasks": "{{decompose_requirements.output.tasks}}",
        "dependencies": "{{analyze_dependencies.output.dependencies}}",
        "estimates": "{{estimate_efforts.output}}",
        "risk_categories": [
          "technical",
          "schedule",
          "resource",
          "dependency",
          "integration",
          "security",
          "compliance"
        ],
        "calculate_risk_score": true,
        "risk_threshold": 0.7
      },
      "depends_on": ["estimate_efforts", "analyze_dependencies"],
      "timeout": 200
    },
    
    {
      "id": "create_risk_mitigation_plan",
      "name": "Create Risk Mitigation Plan",
      "type": "generation",
      "component": null,
      "method": null,
      "parameters": {
        "risks": "{{assess_risks.output.high_risks}}",
        "mitigation_strategies": ["avoid", "transfer", "mitigate", "accept"],
        "create_contingency_plans": true,
        "assign_risk_owners": true,
        "define_triggers": true
      },
      "depends_on": ["assess_risks"]
    },
    
    {
      "id": "optimize_schedule",
      "name": "Optimize Schedule",
      "type": "planning",
      "component": "dependency_planner",
      "method": "optimize_schedule",
      "parameters": {
        "timeline": "{{create_timeline.output.timeline}}",
        "critical_path": "{{identify_critical_path.output.path}}",
        "optimization_strategies": [
          "parallelize_independent_tasks",
          "fast_track_critical_path",
          "level_resources",
          "adjust_dependencies"
        ],
        "target_duration_reduction": "{{input.target_duration_reduction}}",
        "max_iterations": 10
      },
      "depends_on": ["create_timeline", "identify_critical_path"],
      "timeout": 240
    },
    
    {
      "id": "human_review_plan",
      "name": "Human Review: Project Plan",
      "type": "human",
      "parameters": {
        "type": "review",
        "title": "Project Plan Review",
        "description": "Please review the complete project plan including timeline, resources, and risks",
        "required_skills": ["project_management", "technical_leadership", "resource_management"],
        "priority": 0,
        "timeout_hours": 48,
        "data": {
          "work_breakdown_structure": "{{decompose_requirements.output.wbs}}",
          "dependency_graph": "{{build_dependency_graph.output}}",
          "critical_path": "{{identify_critical_path.output}}",
          "timeline": "{{optimize_schedule.output.timeline}}",
          "resource_allocations": "{{allocate_resources.output}}",
          "milestones": "{{identify_milestones.output}}",
          "risk_register": "{{assess_risks.output}}",
          "mitigation_plan": "{{create_risk_mitigation_plan.output}}",
          "key_metrics": {
            "total_duration_days": "{{create_timeline.output.total_duration}}",
            "total_effort_hours": "{{estimate_efforts.output.total_hours}}",
            "resource_utilization": "{{allocate_resources.output.utilization}}",
            "critical_path_length": "{{identify_critical_path.output.length}}"
          }
        },
        "approval_required": true,
        "allow_modifications": true
      },
      "depends_on": ["optimize_schedule", "create_risk_mitigation_plan", "identify_milestones"]
    },
    
    {
      "id": "generate_gantt_chart",
      "name": "Generate Gantt Chart",
      "type": "generation",
      "component": null,
      "method": null,
      "parameters": {
        "timeline": "{{human_review_plan.output.timeline}}",
        "tasks": "{{decompose_requirements.output.tasks}}",
        "allocations": "{{allocate_resources.output.allocations}}",
        "milestones": "{{identify_milestones.output}}",
        "critical_path": "{{identify_critical_path.output.path}}",
        "output_format": "html",
        "include_dependencies": true,
        "include_resource_views": true
      },
      "depends_on": ["human_review_plan"],
      "timeout": 120
    },
    
    {
      "id": "generate_resource_plan",
      "name": "Generate Resource Plan",
      "type": "generation",
      "component": null,
      "method": null,
      "parameters": {
        "allocations": "{{allocate_resources.output}}",
        "timeline": "{{create_timeline.output.timeline}}",
        "resource_availability": "{{check_resource_availability.output}}",
        "output_format": "html",
        "include_workload_heatmap": true,
        "include_skill_gap_analysis": true
      },
      "depends_on": ["human_review_plan"],
      "timeout": 120
    },
    
    {
      "id": "create_budget_estimate",
      "name": "Create Budget Estimate",
      "type": "transform",
      "component": null,
      "method": null,
      "parameters": {
        "effort_hours": "{{estimate_efforts.output.total_hours}}",
        "resource_costs": "{{input.resource_hourly_rates}}",
        "additional_costs": {
          "infrastructure": "{{input.infrastructure_costs}}",
          "tools": "{{input.tool_licenses}}",
          "training": "{{input.training_budget}}",
          "contingency_percentage": 15
        },
        "calculate_roi": true,
        "business_value": "{{input.expected_business_value}}"
      },
      "depends_on": ["estimate_efforts", "allocate_resources"]
    },
    
    {
      "id": "create_communication_plan",
      "name": "Create Communication Plan",
      "type": "generation",
      "component": null,
      "method": null,
      "parameters": {
        "stakeholders": "{{input.stakeholders}}",
        "milestones": "{{identify_milestones.output}}",
        "communication_channels": ["email", "slack", "meeting", "report", "dashboard"],
        "frequency_mapping": {
          "daily": ["daily_standup", "blockers"],
          "weekly": ["progress_report", "risk_review"],
          "milestone": ["demo", "signoff"],
          "monthly": ["executive_summary", "budget_review"]
        },
        "templates": true
      },
      "depends_on": ["identify_milestones"]
    },
    
    {
      "id": "generate_comprehensive_report",
      "name": "Generate Comprehensive Planning Report",
      "type": "generation",
      "component": null,
      "method": null,
      "parameters": {
        "workflow_name": "planning_workflow",
        "sections": [
          "executive_summary",
          "requirements_analysis",
          "work_breakdown_structure",
          "dependency_analysis",
          "critical_path_analysis",
          "resource_allocation",
          "timeline_with_gantt",
          "milestones",
          "risk_assessment",
          "budget_estimate",
          "communication_plan",
          "quality_metrics",
          "appendix"
        ],
        "data": {
          "requirements": "{{collect_requirements.output}}",
          "wbs": "{{decompose_requirements.output}}",
          "dependencies": "{{analyze_dependencies.output}}",
          "critical_path": "{{identify_critical_path.output}}",
          "resources": "{{allocate_resources.output}}",
          "timeline": "{{optimize_schedule.output}}",
          "milestones": "{{identify_milestones.output}}",
          "risks": "{{assess_risks.output}}",
          "budget": "{{create_budget_estimate.output}}",
          "communication": "{{create_communication_plan.output}}",
          "gantt_chart_url": "{{generate_gantt_chart.output.url}}",
          "resource_plan_url": "{{generate_resource_plan.output.url}}"
        },
        "output_format": "html",
        "include_charts": true,
        "include_tables": true
      },
      "depends_on": [
        "generate_gantt_chart",
        "generate_resource_plan",
        "create_budget_estimate",
        "create_communication_plan"
      ],
      "timeout": 300
    },
    
    {
      "id": "export_to_planning_tools",
      "name": "Export to External Planning Tools",
      "type": "function",
      "component": null,
      "method": null,
      "parameters": {
        "target_tools": ["jira", "asana", "microsoft_project", "notion"],
        "data": {
          "tasks": "{{decompose_requirements.output.tasks}}",
          "dependencies": "{{analyze_dependencies.output.dependencies}}",
          "allocations": "{{allocate_resources.output.allocations}}",
          "milestones": "{{identify_milestones.output}}",
          "timeline": "{{optimize_schedule.output.timeline}}"
        },
        "sync_assignees": true,
        "create_epics": true
      },
      "depends_on": ["generate_comprehensive_report"]
    },
    
    {
      "id": "create_planning_version",
      "name": "Create Planning Version Snapshot",
      "type": "transform",
      "component": "state_manager",
      "method": "save_snapshot",
      "parameters": {
        "snapshot_name": "planning_v{{variables.planning_version}}",
        "data": {
          "plan": "{{human_review_plan.output.approved_plan}}",
          "timestamp": "{{context.current_time}}",
          "version": "{{variables.planning_version}}",
          "metrics": {
            "total_tasks": "{{decompose_requirements.output.tasks.length}}",
            "total_effort_hours": "{{estimate_efforts.output.total_hours}}",
            "total_duration_days": "{{create_timeline.output.total_duration}}",
            "resource_count": "{{allocate_resources.output.resource_count}}",
            "risk_count": "{{assess_risks.output.risks.length}}"
          }
        },
        "version_control": true
      },
      "depends_on": ["human_review_plan"]
    },
    
    {
      "id": "notify_team",
      "name": "Notify Team of Planning Completion",
      "type": "notify",
      "component": null,
      "method": null,
      "parameters": {
        "type": "workflow_completed",
        "message": "Project planning completed successfully",
        "channels": ["slack", "email", "dashboard", "event_bus"],
        "recipients": "{{input.stakeholders}}",
        "data": {
          "workflow": "planning_workflow",
          "report_url": "{{generate_comprehensive_report.output.url}}",
          "gantt_chart_url": "{{generate_gantt_chart.output.url}}",
          "key_findings": {
            "start_date": "{{optimize_schedule.output.start_date}}",
            "end_date": "{{optimize_schedule.output.end_date}}",
            "total_duration_days": "{{create_timeline.output.total_duration}}",
            "critical_path_duration": "{{identify_critical_path.output.duration}}",
            "total_resources": "{{allocate_resources.output.resource_count}}",
            "total_budget": "{{create_budget_estimate.output.total_budget}}",
            "high_risks": "{{assess_risks.output.high_risk_count}}"
          }
        }
      },
      "depends_on": ["export_to_planning_tools", "create_planning_version"]
    },
    
    {
      "id": "archive_planning_artifacts",
      "name": "Archive Planning Artifacts",
      "type": "transform",
      "component": null,
      "method": null,
      "parameters": {
        "artifacts": {
          "report": "{{generate_comprehensive_report.output}}",
          "gantt_chart": "{{generate_gantt_chart.output}}",
          "resource_plan": "{{generate_resource_plan.output}}",
          "wbs": "{{decompose_requirements.output}}",
          "risk_register": "{{assess_risks.output}}"
        },
        "archive_location": "{{input.archive_path}}/planning/version_{{variables.planning_version}}",
        "retention_days": 730,
        "create_index": true,
        "compress": true,
        "encrypt_sensitive": true
      },
      "depends_on": ["notify_team"]
    }
  ]
}
