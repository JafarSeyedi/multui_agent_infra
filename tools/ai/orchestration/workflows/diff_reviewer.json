{
  "name": "diff_reviewer_workflow",
  "version": "2.0",
  "description": "Complete diff review workflow - intelligent code change analysis, impact assessment, security review, quality validation, and human approval",
  
  "variables": {
    "diff_analysis": {
      "total_changes": 0,
      "additions": 0,
      "deletions": 0,
      "modified_files": [],
      "affected_modules": [],
      "dependency_impact": []
    },
    "review_metrics": {
      "complexity_change": 0,
      "coverage_impact": 0,
      "security_risk_score": 0,
      "performance_impact": 0,
      "maintainability_score": 0,
      "overall_risk_score": 0
    },
    "review_status": {
      "syntax_check": "pending",
      "style_check": "pending",
      "test_impact": "pending",
      "security_scan": "pending",
      "dependency_check": "pending",
      "human_review": "pending",
      "approval_status": "pending"
    },
    "review_comments": [],
    "suggested_changes": [],
    "auto_merge_allowed": false,
    "critical_issues": [],
    "warnings": []
  },
  
  "tasks": [
    {
      "id": "receive_diff",
      "name": "Receive and Parse Diff",
      "type": "transform",
      "component": null,
      "method": null,
      "parameters": {
        "diff_content": "{{input.diff_content}}",
        "source_branch": "{{input.source_branch}}",
        "target_branch": "{{input.target_branch}}",
        "pull_request_id": "{{input.pull_request_id}}",
        "author": "{{input.author}}",
        "repository": "{{input.repository}}"
      },
      "timeout": 60
    },
    
    {
      "id": "parse_diff_structure",
      "name": "Parse Diff Structure",
      "type": "analysis",
      "component": null,
      "method": "parse_diff",
      "parameters": {
        "diff": "{{receive_diff.output.diff_content}}",
        "extract_metadata": true,
        "identify_file_changes": true,
        "detect_binary_files": true,
        "parse_hunks": true
      },
      "depends_on": ["receive_diff"],
      "timeout": 120
    },
    
    {
      "id": "load_base_context",
      "name": "Load Base Code Context",
      "type": "analysis",
      "component": "project_scanner",
      "method": "load_context",
      "parameters": {
        "repository": "{{input.repository}}",
        "branch": "{{input.target_branch}}",
        "files": "{{parse_diff_structure.output.affected_files}}",
        "load_dependencies": true,
        "load_tests": true
      },
      "depends_on": ["parse_diff_structure"],
      "timeout": 180
    },
    
    {
      "id": "load_head_context",
      "name": "Load Head Code Context",
      "type": "analysis",
      "component": "project_scanner",
      "method": "load_context",
      "parameters": {
        "repository": "{{input.repository}}",
        "branch": "{{input.source_branch}}",
        "files": "{{parse_diff_structure.output.affected_files}}",
        "load_dependencies": true,
        "load_tests": true
      },
      "depends_on": ["parse_diff_structure"],
      "timeout": 180
    },
    
    {
      "id": "analyze_syntax_changes",
      "name": "Analyze Syntax Changes",
      "type": "quality",
      "component": "mypy_validator",
      "method": "validate_syntax_diff",
      "parameters": {
        "base_code": "{{load_base_context.output.files_content}}",
        "head_code": "{{load_head_context.output.files_content}}",
        "modified_files": "{{parse_diff_structure.output.modified_files}}",
        "strict_mode": true
      },
      "depends_on": ["load_base_context", "load_head_context"],
      "timeout": 180
    },
    
    {
      "id": "analyze_style_changes",
      "name": "Analyze Style Changes",
      "type": "quality",
      "component": "ruff_validator",
      "method": "analyze_style_diff",
      "parameters": {
        "base_code": "{{load_base_context.output.files_content}}",
        "head_code": "{{load_head_context.output.files_content}}",
        "modified_files": "{{parse_diff_structure.output.modified_files}}",
        "rules": ["E", "F", "W", "C901", "N", "UP", "B", "SIM"]
      },
      "depends_on": ["analyze_syntax_changes"],
      "timeout": 120
    },
    
    {
      "id": "analyze_complexity_change",
      "name": "Analyze Complexity Change",
      "type": "quality",
      "component": "complexity_validator",
      "method": "analyze_complexity_diff",
      "parameters": {
        "base_code": "{{load_base_context.output.files_content}}",
        "head_code": "{{load_head_context.output.files_content}}",
        "metrics": ["cyclomatic", "cognitive", "maintainability"]
      },
      "depends_on": ["load_base_context", "load_head_context"],
      "timeout": 150
    },
    
    {
      "id": "analyze_dependency_impact",
      "name": "Analyze Dependency Impact",
      "type": "analysis",
      "component": "dependency_validator",
      "method": "analyze_dependency_impact",
      "parameters": {
        "base_graph": "{{load_base_context.output.dependency_graph}}",
        "head_graph": "{{load_head_context.output.dependency_graph}}",
        "modified_files": "{{parse_diff_structure.output.modified_files}}",
        "detect_circular_dependencies": true,
        "identify_breaking_changes": true
      },
      "depends_on": ["load_base_context", "load_head_context"],
      "timeout": 180
    },
    
    {
      "id": "analyze_test_impact",
      "name": "Analyze Test Impact",
      "type": "analysis",
      "component": "test_runner",
      "method": "analyze_test_impact",
      "parameters": {
        "modified_files": "{{parse_diff_structure.output.modified_files}}",
        "base_tests": "{{load_base_context.output.tests}}",
        "head_tests": "{{load_head_context.output.tests}}",
        "identify_affected_tests": true,
        "suggest_new_tests": true
      },
      "depends_on": ["load_base_context", "load_head_context"],
      "timeout": 180
    },
    
    {
      "id": "calculate_coverage_impact",
      "name": "Calculate Coverage Impact",
      "type": "quality",
      "component": "coverage_analyzer",
      "method": "analyze_coverage_impact",
      "parameters": {
        "base_coverage": "{{load_base_context.output.coverage}}",
        "head_coverage": "{{load_head_context.output.coverage}}",
        "modified_files": "{{parse_diff_structure.output.modified_files}}"
      },
      "depends_on": ["load_base_context", "load_head_context"],
      "timeout": 120
    },
    
    {
      "id": "run_security_scan_diff",
      "name": "Run Security Scan on Diff",
      "type": "quality",
      "component": "security_validator",
      "method": "scan_diff",
      "parameters": {
        "base_code": "{{load_base_context.output.files_content}}",
        "head_code": "{{load_head_context.output.files_content}}",
        "modified_files": "{{parse_diff_structure.output.modified_files}}",
        "scan_rules": [
          "sql_injection",
          "xss",
          "command_injection",
          "hardcoded_secrets",
          "weak_crypto",
          "path_traversal"
        ]
      },
      "depends_on": ["load_base_context", "load_head_context"],
      "timeout": 240
    },
    
    {
      "id": "analyze_performance_impact",
      "name": "Analyze Performance Impact",
      "type": "quality",
      "component": "performance_validator",
      "method": "analyze_performance_impact",
      "parameters": {
        "base_code": "{{load_base_context.output.files_content}}",
        "head_code": "{{load_head_context.output.files_content}}",
        "modified_files": "{{parse_diff_structure.output.modified_files}}",
        "check_algorithms": true,
        "detect_regressions": true
      },
      "depends_on": ["load_base_context", "load_head_context"],
      "timeout": 180
    },
    
    {
      "id": "analyze_api_changes",
      "name": "Analyze API Changes",
      "type": "analysis",
      "component": "api_surface_extractor",
      "method": "analyze_api_diff",
      "parameters": {
        "base_api": "{{load_base_context.output.api_surface}}",
        "head_api": "{{load_head_context.output.api_surface}}",
        "detect_breaking_changes": true,
        "check_compatibility": true
      },
      "depends_on": ["load_base_context", "load_head_context"],
      "timeout": 150
    },
    
    {
      "id": "analyze_documentation_impact",
      "name": "Analyze Documentation Impact",
      "type": "quality",
      "component": "docstring_validator",
      "method": "analyze_doc_impact",
      "parameters": {
        "base_code": "{{load_base_context.output.files_content}}",
        "head_code": "{{load_head_context.output.files_content}}",
        "modified_files": "{{parse_diff_structure.output.modified_files}}",
        "check_docstring_updates": true
      },
      "depends_on": ["load_base_context", "load_head_context"],
      "timeout": 120
    },
    
    {
      "id": "calculate_risk_score",
      "name": "Calculate Overall Risk Score",
      "type": "transform",
      "component": null,
      "method": null,
      "parameters": {
        "syntax_issues": "{{analyze_syntax_changes.output.issues.length}}",
        "style_issues": "{{analyze_style_changes.output.issues.length}}",
        "complexity_increase": "{{analyze_complexity_change.output.increase}}",
        "dependency_risk": "{{analyze_dependency_impact.output.risk_level}}",
        "test_impact": "{{analyze_test_impact.output.affected_tests_count}}",
        "coverage_decrease": "{{calculate_coverage_impact.output.decrease}}",
        "security_issues": "{{run_security_scan_diff.output.critical_issues.length}}",
        "performance_degradation": "{{analyze_performance_impact.output.degradation}}",
        "breaking_changes": "{{analyze_api_changes.output.breaking_changes.length}}"
      },
      "depends_on": [
        "analyze_syntax_changes",
        "analyze_style_changes",
        "analyze_complexity_change",
        "analyze_dependency_impact",
        "analyze_test_impact",
        "calculate_coverage_impact",
        "run_security_scan_diff",
        "analyze_performance_impact",
        "analyze_api_changes"
      ]
    },
    
    {
      "id": "generate_auto_review",
      "name": "Generate Auto Review Comments",
      "type": "generation",
      "component": "llm_client",
      "method": "generate_review_comments",
      "parameters": {
        "diff": "{{receive_diff.output.diff_content}}",
        "analysis_results": {
          "syntax": "{{analyze_syntax_changes.output}}",
          "style": "{{analyze_style_changes.output}}",
          "complexity": "{{analyze_complexity_change.output}}",
          "dependencies": "{{analyze_dependency_impact.output}}",
          "security": "{{run_security_scan_diff.output}}",
          "performance": "{{analyze_performance_impact.output}}",
          "api": "{{analyze_api_changes.output}}"
        },
        "risk_score": "{{calculate_risk_score.output}}",
        "review_style": "constructive",
        "max_comments": 20
      },
      "depends_on": ["calculate_risk_score"],
      "timeout": 180
    },
    
    {
      "id": "suggest_improvements",
      "name": "Suggest Code Improvements",
      "type": "generation",
      "component": "iterative_refiner",
      "method": "suggest_improvements",
      "parameters": {
        "diff": "{{receive_diff.output.diff_content}}",
        "issues": "{{generate_auto_review.output.issues}}",
        "context": "{{load_base_context.output}}",
        "improvement_types": ["performance", "security", "maintainability", "testing"]
      },
      "depends_on": ["generate_auto_review"],
      "timeout": 180
    },
    
    {
      "id": "check_merge_readiness",
      "name": "Check Merge Readiness",
      "type": "condition",
      "component": null,
      "method": null,
      "parameters": {
        "risk_score": "{{calculate_risk_score.output.overall}}",
        "critical_issues": "{{run_security_scan_diff.output.critical_issues.length}}",
        "syntax_errors": "{{analyze_syntax_changes.output.errors.length}}",
        "breaking_changes": "{{analyze_api_changes.output.breaking_changes.length}}",
        "auto_merge_threshold": 30,
        "ready_for_merge": "{{risk_score}} <= {{auto_merge_threshold}} and {{critical_issues}} == 0 and {{syntax_errors}} == 0"
      },
      "depends_on": ["calculate_risk_score", "run_security_scan_diff", "analyze_syntax_changes", "analyze_api_changes"]
    },
    
    {
      "id": "auto_approve",
      "name": "Auto Approve Low-Risk Changes",
      "type": "transform",
      "component": null,
      "method": null,
      "parameters": {
        "pull_request_id": "{{input.pull_request_id}}",
        "risk_score": "{{calculate_risk_score.output.overall}}",
        "auto_merge": "{{check_merge_readiness.output.ready_for_merge}}",
        "review_summary": {
          "total_changes": "{{parse_diff_structure.output.total_changes}}",
          "risk_level": "low",
          "recommendation": "auto_approve"
        }
      },
      "depends_on": ["check_merge_readiness"],
      "condition": "{{check_merge_readiness.output.ready_for_merge}} == true"
    },
    
    {
      "id": "human_review_required",
      "name": "Human Review Required",
      "type": "human",
      "parameters": {
        "type": "review",
        "title": "Code Review Required: {{input.pull_request_id}}",
        "description": "Please review the proposed code changes",
        "required_skills": ["code_review", "{{parse_diff_structure.output.primary_language}}"],
        "priority": "{{calculate_risk_score.output.overall > 70 ? 0 : 1}}",
        "timeout_hours": "{{calculate_risk_score.output.overall > 70 ? 12 : 24}}",
        "data": {
          "pull_request": {
            "id": "{{input.pull_request_id}}",
            "title": "{{input.title}}",
            "description": "{{input.description}}",
            "author": "{{input.author}}",
            "source_branch": "{{input.source_branch}}",
            "target_branch": "{{input.target_branch}}"
          },
          "diff_summary": {
            "total_changes": "{{parse_diff_structure.output.total_changes}}",
            "additions": "{{parse_diff_structure.output.additions}}",
            "deletions": "{{parse_diff_structure.output.deletions}}",
            "files_changed": "{{parse_diff_structure.output.modified_files.length}}"
          },
          "analysis_results": {
            "syntax": "{{analyze_syntax_changes.output.summary}}",
            "style": "{{analyze_style_changes.output.summary}}",
            "complexity": "{{analyze_complexity_change.output.summary}}",
            "dependencies": "{{analyze_dependency_impact.output.summary}}",
            "test_impact": "{{analyze_test_impact.output.summary}}",
            "coverage_impact": "{{calculate_coverage_impact.output.summary}}",
            "security": "{{run_security_scan_diff.output.summary}}",
            "performance": "{{analyze_performance_impact.output.summary}}",
            "api_changes": "{{analyze_api_changes.output.summary}}"
          },
          "risk_assessment": {
            "overall_score": "{{calculate_risk_score.output.overall}}",
            "risk_level": "{{calculate_risk_score.output.level}}",
            "critical_issues": "{{calculate_risk_score.output.critical_issues}}",
            "recommendations": "{{calculate_risk_score.output.recommendations}}"
          },
          "auto_review_comments": "{{generate_auto_review.output.comments}}",
          "suggested_improvements": "{{suggest_improvements.output}}",
          "diff_content": "{{receive_diff.output.diff_content}}"
        },
        "interaction_type": "code_review",
        "allow_approve": true,
        "allow_request_changes": true,
        "allow_comment": true
      },
      "depends_on": ["check_merge_readiness", "generate_auto_review", "suggest_improvements"],
      "condition": "{{check_merge_readiness.output.ready_for_merge}} == false"
    },
    
    {
      "id": "process_human_feedback",
      "name": "Process Human Review Feedback",
      "type": "transform",
      "component": null,
      "method": null,
      "parameters": {
        "review_decision": "{{human_review_required.output.decision}}",
        "comments": "{{human_review_required.output.comments}}",
        "requested_changes": "{{human_review_required.output.requested_changes}}",
        "approval_status": "{{human_review_required.output.approved}}"
      },
      "depends_on": ["human_review_required"],
      "condition": "{{check_merge_readiness.output.ready_for_merge}} == false"
    },
    
    {
      "id": "check_approval_status",
      "name": "Check Approval Status",
      "type": "condition",
      "component": null,
      "method": null,
      "parameters": {
        "approved": "{{process_human_feedback.output.approved}}",
        "changes_requested": "{{process_human_feedback.output.changes_requested}}"
      },
      "depends_on": ["process_human_feedback"]
    },
    
    {
      "id": "generate_change_requests",
      "name": "Generate Change Requests",
      "type": "generation",
      "component": null,
      "method": null,
      "parameters": {
        "requested_changes": "{{process_human_feedback.output.requested_changes}}",
        "format": "detailed",
        "include_code_snippets": true,
        "include_examples": true
      },
      "depends_on": ["check_approval_status"],
      "condition": "{{check_approval_status.output.changes_requested}} == true",
      "timeout": 120
    },
    
    {
      "id": "post_review_comments",
      "name": "Post Review Comments to PR",
      "type": "function",
      "component": "git_utils",
      "method": "post_pr_comments",
      "parameters": {
        "pull_request_id": "{{input.pull_request_id}}",
        "comments": "{{generate_auto_review.output.comments}}",
        "review_summary": "{{calculate_risk_score.output.summary}}",
        "inline_comments": "{{generate_auto_review.output.inline_comments}}"
      },
      "depends_on": ["auto_approve", "process_human_feedback"],
      "timeout": 60
    },
    
    {
      "id": "update_pr_status",
      "name": "Update PR Status",
      "type": "function",
      "component": "git_utils",
      "method": "update_pr_status",
      "parameters": {
        "pull_request_id": "{{input.pull_request_id}}",
        "status": "{{auto_approve.output.approved ? 'approved' : (human_review_required.output.approved ? 'approved' : 'changes_requested')}}",
        "context": "ai-diff-reviewer",
        "description": "AI Review: {{calculate_risk_score.output.summary}}"
      },
      "depends_on": ["post_review_comments"],
      "timeout": 30
    },
    
    {
      "id": "generate_review_report",
      "name": "Generate Review Report",
      "type": "generation",
      "component": null,
      "method": null,
      "parameters": {
        "workflow_name": "diff_reviewer_workflow",
        "pull_request_id": "{{input.pull_request_id}}",
        "review_metrics": {
          "risk_score": "{{calculate_risk_score.output}}",
          "complexity_change": "{{analyze_complexity_change.output}}",
          "coverage_impact": "{{calculate_coverage_impact.output}}",
          "security_findings": "{{run_security_scan_diff.output}}",
          "performance_impact": "{{analyze_performance_impact.output}}",
          "api_changes": "{{analyze_api_changes.output}}"
        },
        "review_outcome": {
          "auto_approved": "{{auto_approve.output.approved}}",
          "human_approved": "{{human_review_required.output.approved}}",
          "changes_requested": "{{process_human_feedback.output.changes_requested}}",
          "comments_count": "{{generate_auto_review.output.comments.length}}"
        },
        "recommendations": "{{suggest_improvements.output}}",
        "output_format": "html"
      },
      "depends_on": ["update_pr_status"],
      "timeout": 180
    },
    
    {
      "id": "notify_review_complete",
      "name": "Notify Review Completion",
      "type": "notify",
      "component": null,
      "method": null,
      "parameters": {
        "type": "review_completed",
        "message": "Diff review completed for PR #{{input.pull_request_id}}",
        "channels": ["slack", "event_bus"],
        "recipients": ["{{input.author}}", "{{input.reviewers}}"],
        "data": {
          "pull_request_id": "{{input.pull_request_id}}",
          "decision": "{{auto_approve.output.approved ? 'approved' : (human_review_required.output.approved ? 'approved' : 'changes_requested')}}",
          "risk_score": "{{calculate_risk_score.output.overall}}",
          "report_url": "{{generate_review_report.output.url}}",
          "comments_url": "{{update_pr_status.output.url}}"
        }
      },
      "depends_on": ["generate_review_report"]
    },
    
    {
      "id": "archive_review_data",
      "name": "Archive Review Data",
      "type": "transform",
      "component": null,
      "method": null,
      "parameters": {
        "review_data": {
          "pull_request": {
            "id": "{{input.pull_request_id}}",
            "title": "{{input.title}}",
            "author": "{{input.author}}",
            "timestamp": "{{context.current_time}}"
          },
          "diff_analysis": "{{parse_diff_structure.output}}",
          "review_metrics": "{{calculate_risk_score.output}}",
          "review_outcome": {
            "auto_approved": "{{auto_approve.output.approved}}",
            "human_decision": "{{human_review_required.output.decision}}",
            "comments": "{{generate_auto_review.output.comments}}"
          },
          "report": "{{generate_review_report.output}}"
        },
        "archive_location": "{{input.archive_path}}/diff_reviews/{{input.pull_request_id}}",
        "retention_days": 90,
        "compress": true
      },
      "depends_on": ["notify_review_complete"]
    },
    
    {
      "id": "auto_merge_if_approved",
      "name": "Auto Merge if Approved",
      "type": "function",
      "component": "git_utils",
      "method": "merge_pull_request",
      "parameters": {
        "pull_request_id": "{{input.pull_request_id}}",
        "merge_method": "squash",
        "delete_source_branch": true,
        "merge_condition": "{{auto_approve.output.approved}} or {{human_review_required.output.approved}}"
      },
      "depends_on": ["update_pr_status"],
      "condition": "{{auto_approve.output.approved}} or {{human_review_required.output.approved}}",
      "timeout": 60
    }
  ]
}
