{
  "name": "analysis_workflow",
  "version": "2.0",
  "description": "Complete code analysis workflow - static analysis, metrics collection, quality assessment, dependency analysis, and insight generation",
  
  "variables": {
    "analysis_config": {
      "depth": "comprehensive",
      "include_tests": true,
      "include_docs": true,
      "parallel_execution": true,
      "max_file_size_mb": 10,
      "exclude_patterns": ["**/venv/**", "**/__pycache__/**", "**/.git/**"]
    },
    "analysis_results": {
      "code_metrics": {},
      "quality_scores": {},
      "dependency_graph": {},
      "security_findings": [],
      "performance_insights": [],
      "documentation_coverage": {},
      "test_coverage": {},
      "complexity_hotspots": [],
      "code_smells": []
    },
    "aggregated_metrics": {
      "total_files": 0,
      "total_lines": 0,
      "avg_complexity": 0,
      "avg_maintainability": 0,
      "tech_debt_ratio": 0,
      "overall_health_score": 0
    },
    "analysis_status": {
      "static_analysis": "pending",
      "metrics_collection": "pending",
      "dependency_analysis": "pending",
      "quality_assessment": "pending",
      "report_generation": "pending"
    }
  },
  
  "tasks": [
    {
      "id": "initialize_analysis",
      "name": "Initialize Code Analysis",
      "type": "transform",
      "component": null,
      "method": null,
      "parameters": {
        "project_path": "{{input.project_path}}",
        "analysis_scope": "{{input.analysis_scope}}",
        "analysis_depth": "{{input.analysis_depth}}",
        "output_format": "{{input.output_format}}"
      },
      "timeout": 60
    },
    
    {
      "id": "scan_project_structure",
      "name": "Scan Project Structure",
      "type": "analysis",
      "component": "project_scanner",
      "method": "scan_structure",
      "parameters": {
        "project_path": "{{input.project_path}}",
        "recursive": true,
        "include_hidden": false,
        "follow_symlinks": false,
        "exclude_patterns": "{{analysis_config.exclude_patterns}}"
      },
      "depends_on": ["initialize_analysis"],
      "timeout": 300
    },
    
    {
      "id": "discover_files",
      "name": "Discover Analysis Files",
      "type": "transform",
      "component": null,
      "method": null,
      "parameters": {
        "scan_results": "{{scan_project_structure.output}}",
        "file_extensions": [".py", ".md", ".yaml", ".json", ".toml"],
        "min_file_size_bytes": 0,
        "max_file_size_mb": "{{analysis_config.max_file_size_mb}}"
      },
      "depends_on": ["scan_project_structure"],
      "timeout": 120
    },
    
    {
      "id": "analyze_code_metrics",
      "name": "Analyze Code Metrics",
      "type": "quality",
      "component": "complexity_validator",
      "method": "analyze_all_metrics",
      "parameters": {
        "files": "{{discover_files.output.python_files}}",
        "metrics": [
          "lines_of_code",
          "cyclomatic_complexity",
          "cognitive_complexity",
          "maintainability_index",
          "halstead_volume",
          "effort_estimate",
          "comment_density"
        ],
        "aggregate_by_directory": true
      },
      "depends_on": ["discover_files"],
      "timeout": 600
    },
    
    {
      "id": "run_static_analysis",
      "name": "Run Static Code Analysis",
      "type": "quality",
      "component": "ruff_validator",
      "method": "full_analysis",
      "parameters": {
        "files": "{{discover_files.output.python_files}}",
        "rules": ["all"],
        "severity_levels": ["error", "warning", "info", "hint"],
        "output_format": "json",
        "fix_suggestions": true
      },
      "depends_on": ["discover_files"],
      "timeout": 600
    },
    
    {
      "id": "analyze_import_graph",
      "name": "Build Import Dependency Graph",
      "type": "analysis",
      "component": "import_graph",
      "method": "build_graph",
      "parameters": {
        "files": "{{discover_files.output.python_files}}",
        "analyze_imports": true,
        "detect_cycles": true,
        "calculate_layer_metrics": true,
        "visualization_format": "mermaid"
      },
      "depends_on": ["discover_files"],
      "timeout": 300
    },
    
    {
      "id": "analyze_dependencies",
      "name": "Analyze External Dependencies",
      "type": "analysis",
      "component": "dependency_validator",
      "method": "analyze_external_deps",
      "parameters": {
        "requirements_file": "{{input.requirements_file}}",
        "check_outdated": true,
        "check_vulnerabilities": true,
        "check_licenses": true,
        "check_compatibility": true
      },
      "depends_on": ["discover_files"],
      "timeout": 300
    },
    
    {
      "id": "analyze_test_coverage",
      "name": "Analyze Test Coverage",
      "type": "quality",
      "component": "coverage_analyzer",
      "method": "analyze_coverage",
      "parameters": {
        "source_files": "{{discover_files.output.python_files}}",
        "test_files": "{{discover_files.output.test_files}}",
        "coverage_type": "line_branch",
        "generate_missing_report": true,
        "thresholds": {
          "line": 80,
          "branch": 70,
          "function": 85
        }
      },
      "depends_on": ["discover_files"],
      "timeout": 600
    },
    
    {
      "id": "analyze_security",
      "name": "Security Vulnerability Analysis",
      "type": "quality",
      "component": "security_validator",
      "method": "full_security_scan",
      "parameters": {
        "files": "{{discover_files.output.python_files}}",
        "scan_rules": [
          "sql_injection",
          "xss",
          "command_injection",
          "hardcoded_secrets",
          "weak_crypto",
          "path_traversal",
          "insecure_deserialization",
          "log_injection",
          "ssrf",
          "xxe"
        ],
        "severity_threshold": "medium",
        "sast_rules": true
      },
      "depends_on": ["discover_files"],
      "timeout": 600
    },
    
    {
      "id": "analyze_performance",
      "name": "Performance Analysis",
      "type": "quality",
      "component": "performance_validator",
      "method": "analyze_performance_patterns",
      "parameters": {
        "files": "{{discover_files.output.python_files}}",
        "patterns": [
          "n_plus_one_queries",
          "inefficient_loops",
          "memory_leaks",
          "expensive_operations",
          "blocking_calls",
          "unoptimized_algorithms"
        ],
        "complexity_analysis": true,
        "suggest_optimizations": true
      },
      "depends_on": ["discover_files"],
      "timeout": 600
    },
    
    {
      "id": "analyze_documentation",
      "name": "Documentation Coverage Analysis",
      "type": "quality",
      "component": "docstring_validator",
      "method": "analyze_documentation",
      "parameters": {
        "files": "{{discover_files.output.python_files}}",
        "check_public_apis": true,
        "check_module_docstrings": true,
        "check_class_docstrings": true,
        "check_function_docstrings": true,
        "docstring_format": "google"
      },
      "depends_on": ["discover_files"],
      "timeout": 300
    },
    
    {
      "id": "identify_code_smells",
      "name": "Identify Code Smells",
      "type": "analysis",
      "component": "ast_analyzer",
      "method": "detect_code_smells",
      "parameters": {
        "files": "{{discover_files.output.python_files}}",
        "smell_types": [
          "long_method",
          "large_class",
          "duplicate_code",
          "feature_envy",
          "data_clumps",
          "primitive_obsession",
          "message_chains",
          "middle_man"
        ],
        "thresholds": {
          "max_method_lines": 50,
          "max_class_lines": 500,
          "max_parameters": 5
        }
      },
      "depends_on": ["analyze_code_metrics"],
      "timeout": 600
    },
    
    {
      "id": "find_complexity_hotspots",
      "name": "Find Complexity Hotspots",
      "type": "analysis",
      "component": "complexity_validator",
      "method": "identify_hotspots",
      "parameters": {
        "metrics": "{{analyze_code_metrics.output}}",
        "threshold_percentile": 90,
        "min_complexity": 10,
        "sort_by": "cyclomatic_complexity"
      },
      "depends_on": ["analyze_code_metrics"],
      "timeout": 180
    },
    
    {
      "id": "calculate_quality_scores",
      "name": "Calculate Quality Scores",
      "type": "transform",
      "component": null,
      "method": null,
      "parameters": {
        "metrics": {
          "complexity": "{{analyze_code_metrics.output.normalized_score}}",
          "static_analysis": "{{run_static_analysis.output.score}}",
          "test_coverage": "{{analyze_test_coverage.output.score}}",
          "security": "{{analyze_security.output.score}}",
          "performance": "{{analyze_performance.output.score}}",
          "documentation": "{{analyze_documentation.output.score}}",
          "code_smells": "{{identify_code_smells.output.score}}"
        },
        "weights": {
          "complexity": 15,
          "static_analysis": 15,
          "test_coverage": 20,
          "security": 20,
          "performance": 10,
          "documentation": 10,
          "code_smells": 10
        },
        "calculate_health_score": true
      },
      "depends_on": [
        "analyze_code_metrics",
        "run_static_analysis",
        "analyze_test_coverage",
        "analyze_security",
        "analyze_performance",
        "analyze_documentation",
        "identify_code_smells"
      ]
    },
    
    {
      "id": "calculate_tech_debt",
      "name": "Calculate Technical Debt",
      "type": "transform",
      "component": null,
      "method": null,
      "parameters": {
        "code_smells": "{{identify_code_smells.output.smells}}",
        "complexity_issues": "{{find_complexity_hotspots.output.issues}}",
        "static_issues": "{{run_static_analysis.output.issues}}",
        "security_issues": "{{analyze_security.output.issues}}",
        "coverage_gaps": "{{analyze_test_coverage.output.gaps}}",
        "debt_formula": "estimated_fix_hours = (smells * 0.5) + (complexity_issues * 2) + (static_issues * 0.25) + (security_issues * 4) + (coverage_gaps * 1)",
        "calculate_interest": true
      },
      "depends_on": [
        "identify_code_smells",
        "find_complexity_hotspots",
        "run_static_analysis",
        "analyze_security",
        "analyze_test_coverage"
      ]
    },
    
    {
      "id": "generate_recommendations",
      "name": "Generate Improvement Recommendations",
      "type": "generation",
      "component": "llm_client",
      "method": "generate_recommendations",
      "parameters": {
        "analysis_data": {
          "metrics": "{{analyze_code_metrics.output}}",
          "code_smells": "{{identify_code_smells.output}}",
          "complexity_hotspots": "{{find_complexity_hotspots.output}}",
          "security_issues": "{{analyze_security.output}}",
          "performance_issues": "{{analyze_performance.output}}",
          "documentation_gaps": "{{analyze_documentation.output.gaps}}",
          "test_gaps": "{{analyze_test_coverage.output.gaps}}"
        },
        "recommendation_types": [
          "critical",
          "high_priority",
          "medium_priority",
          "nice_to_have"
        ],
        "max_recommendations": 20
      },
      "depends_on": ["calculate_quality_scores", "calculate_tech_debt"],
      "timeout": 300
    },
    
    {
      "id": "identify_architectural_issues",
      "name": "Identify Architectural Issues",
      "type": "analysis",
      "component": "architecture_validator",
      "method": "identify_issues",
      "parameters": {
        "dependency_graph": "{{analyze_import_graph.output}}",
        "patterns": [
          "circular_dependencies",
          "layering_violations",
          "god_objects",
          "unstable_dependencies",
          "abstract_dependencies"
        ],
        "architecture_pattern": "{{input.architecture_pattern}}"
      },
      "depends_on": ["analyze_import_graph"],
      "timeout": 300
    },
    
    {
      "id": "analyze_evolution_trends",
      "name": "Analyze Evolution Trends",
      "type": "analysis",
      "component": null,
      "method": "analyze_trends",
      "parameters": {
        "historical_data": "{{input.historical_data}}",
        "metrics_to_track": [
          "complexity_trend",
          "coverage_trend",
          "security_trend",
          "tech_debt_trend"
        ],
        "lookback_commits": 100,
        "detect_regressions": true
      },
      "depends_on": ["calculate_quality_scores"],
      "timeout": 300
    },
    
    {
      "id": "compare_with_benchmarks",
      "name": "Compare with Industry Benchmarks",
      "type": "analysis",
      "component": null,
      "method": "compare_benchmarks",
      "parameters": {
        "current_metrics": "{{calculate_quality_scores.output}}",
        "benchmark_source": "{{input.benchmark_source}}",
        "industry": "{{input.industry}}",
        "company_size": "{{input.company_size}}",
        "percentile_ranking": true
      },
      "depends_on": ["calculate_quality_scores"],
      "timeout": 120
    },
    
    {
      "id": "generate_visualizations",
      "name": "Generate Analysis Visualizations",
      "type": "generation",
      "component": null,
      "method": null,
      "parameters": {
        "dependency_graph": "{{analyze_import_graph.output.graph}}",
        "complexity_heatmap": "{{find_complexity_hotspots.output.heatmap}}",
        "coverage_map": "{{analyze_test_coverage.output.coverage_map}}",
        "trend_charts": "{{analyze_evolution_trends.output.charts}}",
        "output_formats": ["svg", "png", "html"]
      },
      "depends_on": [
        "analyze_import_graph",
        "find_complexity_hotspots",
        "analyze_test_coverage",
        "analyze_evolution_trends"
      ],
      "timeout": 300
    },
    
    {
      "id": "generate_analysis_report",
      "name": "Generate Comprehensive Analysis Report",
      "type": "generation",
      "component": null,
      "method": null,
      "parameters": {
        "workflow_name": "analysis_workflow",
        "execution_id": "{{context.execution_id}}",
        "report_sections": [
          "executive_summary",
          "key_findings",
          "quality_metrics",
          "security_assessment",
          "performance_insights",
          "dependency_analysis",
          "complexity_hotspots",
          "code_smells",
          "test_coverage",
          "documentation_quality",
          "technical_debt",
          "recommendations",
          "benchmark_comparison",
          "appendix"
        ],
        "data": {
          "project_metadata": {
            "name": "{{input.project_name}}",
            "version": "{{input.project_version}}",
            "analysis_date": "{{context.current_time}}",
            "total_files": "{{discover_files.output.total_count}}",
            "total_lines": "{{analyze_code_metrics.output.total_lines}}"
          },
          "aggregated_metrics": "{{aggregated_metrics}}",
          "quality_scores": "{{calculate_quality_scores.output}}",
          "technical_debt": "{{calculate_tech_debt.output}}",
          "security_findings": "{{analyze_security.output.summary}}",
          "recommendations": "{{generate_recommendations.output}}",
          "benchmarks": "{{compare_with_benchmarks.output}}"
        },
        "visualizations": "{{generate_visualizations.output}}",
        "output_format": "html",
        "include_executive_summary": true,
        "include_detailed_analysis": true,
        "include_action_items": true
      },
      "depends_on": [
        "generate_recommendations",
        "calculate_tech_debt",
        "compare_with_benchmarks",
        "generate_visualizations"
      ],
      "timeout": 600
    },
    
    {
      "id": "export_analysis_data",
      "name": "Export Analysis Data",
      "type": "transform",
      "component": null,
      "method": null,
      "parameters": {
        "data": {
          "metrics": "{{analyze_code_metrics.output}}",
          "quality_scores": "{{calculate_quality_scores.output}}",
          "dependency_graph": "{{analyze_import_graph.output}}",
          "security_findings": "{{analyze_security.output}}",
          "recommendations": "{{generate_recommendations.output}}"
        },
        "export_formats": ["json", "csv", "yaml"],
        "export_location": "{{input.export_path}}",
        "compress": true
      },
      "depends_on": ["generate_analysis_report"],
      "timeout": 180
    },
    
    {
      "id": "store_results",
      "name": "Store Analysis Results",
      "type": "transform",
      "component": "state_manager",
      "method": "store_analysis",
      "parameters": {
        "analysis_id": "{{context.execution_id}}",
        "project_path": "{{input.project_path}}",
        "timestamp": "{{context.current_time}}",
        "results": {
          "metrics": "{{analyze_code_metrics.output}}",
          "quality_scores": "{{calculate_quality_scores.output}}",
          "recommendations": "{{generate_recommendations.output}}",
          "report_url": "{{generate_analysis_report.output.url}}"
        },
        "retention_days": 90,
        "create_snapshot": true
      },
      "depends_on": ["export_analysis_data"],
      "timeout": 120
    },
    
    {
      "id": "create_ci_report",
      "name": "Create CI/CD Report",
      "type": "transform",
      "component": null,
      "method": null,
      "parameters": {
        "quality_score": "{{calculate_quality_scores.output.overall}}",
        "passing_threshold": 75,
        "create_badge": true,
        "update_ci_status": true,
        "badge_output_path": "{{input.badge_path}}"
      },
      "depends_on": ["calculate_quality_scores"],
      "timeout": 60
    },
    
    {
      "id": "notify_stakeholders",
      "name": "Notify Analysis Completion",
      "type": "notify",
      "component": null,
      "method": null,
      "parameters": {
        "type": "workflow_completed",
        "message": "Code analysis completed for {{input.project_name}}",
        "channels": ["slack", "email", "event_bus", "dashboard"],
        "recipients": "{{input.stakeholders}}",
        "data": {
          "project": "{{input.project_name}}",
          "quality_score": "{{calculate_quality_scores.output.overall}}",
          "health_score": "{{calculate_quality_scores.output.health}}",
          "tech_debt_hours": "{{calculate_tech_debt.output.total_hours}}",
          "critical_issues": "{{analyze_security.output.critical_count}}",
          "report_url": "{{generate_analysis_report.output.url}}",
          "badge_url": "{{create_ci_report.output.badge_url}}"
        },
        "priority": "high",
        "include_summary": true
      },
      "depends_on": ["store_results", "create_ci_report"],
      "timeout": 60
    },
    
    {
      "id": "archive_analysis",
      "name": "Archive Analysis Artifacts",
      "type": "transform",
      "component": null,
      "method": null,
      "parameters": {
        "artifacts": {
          "report": "{{generate_analysis_report.output}}",
          "export_data": "{{export_analysis_data.output}}",
          "visualizations": "{{generate_visualizations.output}}",
          "raw_metrics": "{{analyze_code_metrics.output}}"
        },
        "archive_location": "{{input.archive_path}}/analysis/{{context.execution_id}}",
        "retention_days": 365,
        "compress": true,
        "create_index": true
      },
      "depends_on": ["notify_stakeholders"],
      "timeout": 180
    }
  ]
}
