{
  "name": "design_review_workflow",
  "version": "2.0",
  "description": "Complete design review workflow - architecture validation, design pattern analysis, trade-off evaluation, risk assessment, and stakeholder approval",
  
  "variables": {
    "design_artifacts": {
      "architecture_diagram": null,
      "sequence_diagrams": [],
      "class_diagrams": [],
      "api_specification": null,
      "database_schema": null,
      "deployment_architecture": null
    },
    "review_criteria": {
      "architectural_fitness": 0,
      "design_patterns": 0,
      "scalability": 0,
      "security": 0,
      "performance": 0,
      "maintainability": 0,
      "testability": 0,
      "reliability": 0
    },
    "trade_offs": [],
    "risks": [],
    "alternatives": [],
    "review_status": {
      "technical_review": "pending",
      "security_review": "pending",
      "performance_review": "pending",
      "data_review": "pending",
      "stakeholder_review": "pending",
      "final_approval": "pending"
    },
    "review_comments": [],
    "action_items": [],
    "overall_score": 0,
    "recommendation": "pending"
  },
  
  "tasks": [
    {
      "id": "receive_design_document",
      "name": "Receive Design Document",
      "type": "transform",
      "component": null,
      "method": null,
      "parameters": {
        "design_document": "{{input.design_document}}",
        "document_format": "{{input.format}}",
        "author": "{{input.author}}",
        "version": "{{input.version}}",
        "design_type": "{{input.design_type}}",
        "context": "{{input.context}}"
      },
      "timeout": 60
    },
    
    {
      "id": "parse_design_document",
      "name": "Parse and Structure Design Document",
      "type": "analysis",
      "component": null,
      "method": "parse_design",
      "parameters": {
        "document": "{{receive_design_document.output.design_document}}",
        "extract_sections": [
          "executive_summary",
          "architecture",
          "components",
          "data_model",
          "api_design",
          "security",
          "deployment",
          "alternatives",
          "risks"
        ],
        "extract_diagrams": true,
        "parse_tables": true
      },
      "depends_on": ["receive_design_document"],
      "timeout": 180
    },
    
    {
      "id": "validate_design_structure",
      "name": "Validate Design Document Structure",
      "type": "quality",
      "component": "architecture_validator",
      "method": "validate_design_structure",
      "parameters": {
        "design_sections": "{{parse_design_document.output.sections}}",
        "required_sections": [
          "architecture_overview",
          "component_descriptions",
          "data_flow",
          "security_considerations",
          "scalability_plan",
          "failure_modes",
          "monitoring_strategy"
        ],
        "min_completeness_score": 80
      },
      "depends_on": ["parse_design_document"],
      "timeout": 120
    },
    
    {
      "id": "extract_architecture",
      "name": "Extract Architecture Information",
      "type": "analysis",
      "component": "architecture_validator",
      "method": "extract_architecture",
      "parameters": {
        "design_document": "{{receive_design_document.output.design_document}}",
        "extract_patterns": true,
        "extract_components": true,
        "extract_interfaces": true,
        "extract_data_flows": true
      },
      "depends_on": ["parse_design_document"],
      "timeout": 180
    },
    
    {
      "id": "analyze_architectural_patterns",
      "name": "Analyze Architectural Patterns",
      "type": "analysis",
      "component": "architecture_validator",
      "method": "analyze_patterns",
      "parameters": {
        "architecture": "{{extract_architecture.output}}",
        "detected_patterns": [
          "layered",
          "microservices",
          "event_driven",
          "cqrs",
          "hexagonal",
          "clean_architecture",
          "serverless"
        ],
        "evaluate_appropriateness": true
      },
      "depends_on": ["extract_architecture"],
      "timeout": 150
    },
    
    {
      "id": "validate_design_principles",
      "name": "Validate Design Principles",
      "type": "quality",
      "component": "architecture_validator",
      "method": "validate_principles",
      "parameters": {
        "design": "{{extract_architecture.output}}",
        "principles": [
          "separation_of_concerns",
          "single_responsibility",
          "dependency_inversion",
          "encapsulation",
          "modularity",
          "reusability"
        ],
        "principle_compliance_threshold": 80
      },
      "depends_on": ["extract_architecture"],
      "timeout": 120
    },
    
    {
      "id": "analyze_scalability",
      "name": "Analyze Scalability",
      "type": "analysis",
      "component": "performance_validator",
      "method": "analyze_scalability",
      "parameters": {
        "design": "{{extract_architecture.output}}",
        "expected_load": "{{input.expected_load}}",
        "growth_rate": "{{input.growth_rate}}",
        "analysis_areas": ["horizontal_scaling", "vertical_scaling", "database_scaling", "caching_strategy"]
      },
      "depends_on": ["extract_architecture"],
      "timeout": 180
    },
    
    {
      "id": "analyze_security",
      "name": "Analyze Security Architecture",
      "type": "analysis",
      "component": "security_validator",
      "method": "analyze_security_architecture",
      "parameters": {
        "design": "{{extract_architecture.output}}",
        "security_areas": [
          "authentication",
          "authorization",
          "data_encryption",
          "network_security",
          "input_validation",
          "audit_logging",
          "threat_modeling"
        ],
        "compliance_requirements": "{{input.compliance_requirements}}"
      },
      "depends_on": ["extract_architecture"],
      "timeout": 200
    },
    
    {
      "id": "analyze_data_model",
      "name": "Analyze Data Model",
      "type": "analysis",
      "component": null,
      "method": "analyze_data_model",
      "parameters": {
        "data_model": "{{parse_design_document.output.sections.data_model}}",
        "check_normalization": true,
        "check_indexing_strategy": true,
        "analyze_query_patterns": true,
        "estimate_data_volume": "{{input.estimated_data_volume}}"
      },
      "depends_on": ["parse_design_document"],
      "timeout": 150
    },
    
    {
      "id": "analyze_api_design",
      "name": "Analyze API Design",
      "type": "analysis",
      "component": "api_consistency",
      "method": "analyze_api_design",
      "parameters": {
        "api_spec": "{{parse_design_document.output.sections.api_design}}",
        "check_restful_principles": true,
        "check_versioning_strategy": true,
        "check_error_handling": true,
        "check_rate_limiting": true,
        "check_documentation_quality": true
      },
      "depends_on": ["parse_design_document"],
      "timeout": 150
    },
    
    {
      "id": "analyze_deployment",
      "name": "Analyze Deployment Architecture",
      "type": "analysis",
      "component": null,
      "method": "analyze_deployment",
      "parameters": {
        "deployment_plan": "{{parse_design_document.output.sections.deployment}}",
        "environments": ["dev", "staging", "production"],
        "ci_cd_pipeline": "{{input.ci_cd_configuration}}",
        "rollback_strategy": true,
        "blue_green_deployment": "{{input.blue_green_enabled}}"
      },
      "depends_on": ["parse_design_document"],
      "timeout": 120
    },
    
    {
      "id": "analyze_monitoring",
      "name": "Analyze Observability",
      "type": "analysis",
      "component": null,
      "method": "analyze_monitoring",
      "parameters": {
        "design": "{{extract_architecture.output}}",
        "check_logging_strategy": true,
        "check_metrics_collection": true,
        "check_tracing": true,
        "check_alerting": true,
        "check_dashboards": true
      },
      "depends_on": ["extract_architecture"],
      "timeout": 120
    },
    
    {
      "id": "identify_trade_offs",
      "name": "Identify Design Trade-offs",
      "type": "analysis",
      "component": "impact_analyzer",
      "method": "identify_tradeoffs",
      "parameters": {
        "design": "{{extract_architecture.output}}",
        "alternatives": "{{parse_design_document.output.sections.alternatives}}",
        "tradeoff_categories": [
          "consistency_vs_availability",
          "latency_vs_throughput",
          "cost_vs_performance",
          "simplicity_vs_flexibility",
          "security_vs_usability"
        ]
      },
      "depends_on": ["extract_architecture", "parse_design_document"],
      "timeout": 150
    },
    
    {
      "id": "assess_risks",
      "name": "Assess Technical Risks",
      "type": "analysis",
      "component": "impact_analyzer",
      "method": "assess_technical_risks",
      "parameters": {
        "design": "{{extract_architecture.output}}",
        "risk_categories": [
          "technical_debt",
          "integration_complexity",
          "performance_bottlenecks",
          "security_vulnerabilities",
          "scalability_limits",
          "vendor_lock_in",
          "skill_gaps"
        ],
        "calculate_risk_scores": true
      },
      "depends_on": ["extract_architecture", "analyze_scalability", "analyze_security"],
      "timeout": 180
    },
    
    {
      "id": "generate_alternatives_analysis",
      "name": "Generate Alternatives Analysis",
      "type": "generation",
      "component": "llm_client",
      "method": "analyze_alternatives",
      "parameters": {
        "current_design": "{{extract_architecture.output}}",
        "requirements": "{{input.requirements}}",
        "constraints": "{{input.constraints}}",
        "generate_comparison_matrix": true,
        "score_alternatives": true
      },
      "depends_on": ["identify_trade_offs", "assess_risks"],
      "timeout": 180
    },
    
    {
      "id": "calculate_design_score",
      "name": "Calculate Design Quality Score",
      "type": "transform",
      "component": null,
      "method": null,
      "parameters": {
        "criteria_scores": {
          "architectural_fitness": "{{validate_design_principles.output.compliance_score}}",
          "scalability": "{{analyze_scalability.output.score}}",
          "security": "{{analyze_security.output.score}}",
          "data_model": "{{analyze_data_model.output.score}}",
          "api_design": "{{analyze_api_design.output.score}}",
          "deployment": "{{analyze_deployment.output.score}}",
          "monitoring": "{{analyze_monitoring.output.score}}",
          "tradeoffs": "{{identify_trade_offs.output.balance_score}}"
        },
        "weights": {
          "architectural_fitness": 20,
          "scalability": 15,
          "security": 20,
          "data_model": 10,
          "api_design": 10,
          "deployment": 10,
          "monitoring": 5,
          "tradeoffs": 10
        }
      },
      "depends_on": [
        "validate_design_principles",
        "analyze_scalability",
        "analyze_security",
        "analyze_data_model",
        "analyze_api_design",
        "analyze_deployment",
        "analyze_monitoring",
        "identify_trade_offs"
      ]
    },
    
    {
      "id": "generate_review_comments",
      "name": "Generate Review Comments",
      "type": "generation",
      "component": "llm_client",
      "method": "generate_review_comments",
      "parameters": {
        "design": "{{extract_architecture.output}}",
        "analysis_results": {
          "architecture": "{{analyze_architectural_patterns.output}}",
          "principles": "{{validate_design_principles.output}}",
          "scalability": "{{analyze_scalability.output}}",
          "security": "{{analyze_security.output}}",
          "data_model": "{{analyze_data_model.output}}",
          "api": "{{analyze_api_design.output}}",
          "deployment": "{{analyze_deployment.output}}",
          "tradeoffs": "{{identify_trade_offs.output}}",
          "risks": "{{assess_risks.output}}"
        },
        "score": "{{calculate_design_score.output}}",
        "comment_types": ["strengths", "weaknesses", "suggestions", "questions"]
      },
      "depends_on": ["calculate_design_score"],
      "timeout": 180
    },
    
    {
      "id": "technical_review",
      "name": "Technical Architecture Review",
      "type": "human",
      "parameters": {
        "type": "review",
        "title": "Technical Architecture Review",
        "description": "Senior architects review the technical design",
        "required_skills": ["architecture", "system_design", "technical_leadership"],
        "priority": 0,
        "timeout_hours": 48,
        "data": {
          "design_summary": "{{extract_architecture.output.summary}}",
          "architectural_patterns": "{{analyze_architectural_patterns.output}}",
          "design_score": "{{calculate_design_score.output}}",
          "review_comments": "{{generate_review_comments.output}}",
          "risks": "{{assess_risks.output}}",
          "tradeoffs": "{{identify_trade_offs.output}}",
          "alternatives": "{{generate_alternatives_analysis.output}}"
        },
        "interaction_type": "design_review",
        "approval_required": true,
        "reviewers": "{{input.technical_reviewers}}"
      },
      "depends_on": ["generate_review_comments", "generate_alternatives_analysis"]
    },
    
    {
      "id": "security_review",
      "name": "Security Architecture Review",
      "type": "human",
      "parameters": {
        "type": "review",
        "title": "Security Architecture Review",
        "description": "Security team reviews security design",
        "required_skills": ["security_architecture", "threat_modeling"],
        "priority": 0,
        "timeout_hours": 48,
        "data": {
          "security_analysis": "{{analyze_security.output}}",
          "threat_model": "{{analyze_security.output.threat_model}}",
          "compliance_check": "{{analyze_security.output.compliance}}",
          "security_recommendations": "{{analyze_security.output.recommendations}}"
        },
        "interaction_type": "security_review",
        "approval_required": true,
        "reviewers": "{{input.security_reviewers}}"
      },
      "depends_on": ["analyze_security"]
    },
    
    {
      "id": "performance_review",
      "name": "Performance Review",
      "type": "human",
      "parameters": {
        "type": "review",
        "title": "Performance Architecture Review",
        "description": "Performance team reviews scalability and performance design",
        "required_skills": ["performance_engineering", "scalability"],
        "priority": 1,
        "timeout_hours": 48,
        "data": {
          "scalability_analysis": "{{analyze_scalability.output}}",
          "performance_estimates": "{{analyze_scalability.output.estimates}}",
          "bottlenecks": "{{analyze_scalability.output.bottlenecks}}",
          "recommendations": "{{analyze_scalability.output.recommendations}}"
        },
        "interaction_type": "performance_review",
        "approval_required": true,
        "reviewers": "{{input.performance_reviewers}}"
      },
      "depends_on": ["analyze_scalability"]
    },
    
    {
      "id": "data_review",
      "name": "Data Architecture Review",
      "type": "human",
      "parameters": {
        "type": "review",
        "title": "Data Architecture Review",
        "description": "Data team reviews data model and storage design",
        "required_skills": ["data_modeling", "database_design"],
        "priority": 1,
        "timeout_hours": 48,
        "data": {
          "data_model": "{{analyze_data_model.output}}",
          "query_patterns": "{{analyze_data_model.output.query_patterns}}",
          "storage_estimates": "{{analyze_data_model.output.storage_estimates}}",
          "data_governance": "{{analyze_data_model.output.governance}}"
        },
        "interaction_type": "data_review",
        "approval_required": true,
        "reviewers": "{{input.data_reviewers}}"
      },
      "depends_on": ["analyze_data_model"]
    },
    
    {
      "id": "consolidate_reviews",
      "name": "Consolidate Review Feedback",
      "type": "transform",
      "component": null,
      "method": null,
      "parameters": {
        "technical_feedback": "{{technical_review.output}}",
        "security_feedback": "{{security_review.output}}",
        "performance_feedback": "{{performance_review.output}}",
        "data_feedback": "{{data_review.output}}",
        "consolidate_action_items": true,
        "resolve_conflicts": true,
        "prioritize_feedback": true
      },
      "depends_on": ["technical_review", "security_review", "performance_review", "data_review"],
      "timeout": 120
    },
    
    {
      "id": "stakeholder_review",
      "name": "Stakeholder Review",
      "type": "human",
      "parameters": {
        "type": "review",
        "title": "Stakeholder Design Review",
        "description": "Business stakeholders review design for alignment",
        "required_skills": ["product_management", "business_analysis"],
        "priority": 0,
        "timeout_hours": 72,
        "data": {
          "design_summary": "{{extract_architecture.output.summary}}",
          "tradeoffs": "{{identify_trade_offs.output}}",
          "alternatives": "{{generate_alternatives_analysis.output}}",
          "consolidated_feedback": "{{consolidate_reviews.output}}",
          "action_items": "{{consolidate_reviews.output.action_items}}"
        },
        "interaction_type": "stakeholder_review",
        "approval_required": true,
        "stakeholders": "{{input.stakeholders}}"
      },
      "depends_on": ["consolidate_reviews"]
    },
    
    {
      "id": "update_design",
      "name": "Update Design Based on Feedback",
      "type": "refinement",
      "component": "iterative_refiner",
      "method": "update_design",
      "parameters": {
        "original_design": "{{receive_design_document.output.design_document}}",
        "feedback": "{{consolidate_reviews.output}}",
        "stakeholder_input": "{{stakeholder_review.output}}",
        "generate_revised_design": true,
        "track_changes": true
      },
      "depends_on": ["stakeholder_review"],
      "timeout": 300
    },
    
    {
      "id": "validate_updates",
      "name": "Validate Design Updates",
      "type": "quality",
      "component": "architecture_validator",
      "method": "validate_updates",
      "parameters": {
        "original_design": "{{extract_architecture.output}}",
        "updated_design": "{{update_design.output}}",
        "check_integrity": true,
        "check_consistency": true,
        "check_completeness": true
      },
      "depends_on": ["update_design"],
      "timeout": 120
    },
    
    {
      "id": "calculate_final_score",
      "name": "Calculate Final Design Score",
      "type": "transform",
      "component": null,
      "method": null,
      "parameters": {
        "initial_score": "{{calculate_design_score.output.overall}}",
        "feedback_incorporated": "{{update_design.output.changes_applied}}",
        "reviewer_approvals": {
          "technical": "{{technical_review.output.approved}}",
          "security": "{{security_review.output.approved}}",
          "performance": "{{performance_review.output.approved}}",
          "data": "{{data_review.output.approved}}",
          "stakeholder": "{{stakeholder_review.output.approved}}"
        },
        "final_score_formula": "initial_score * 0.6 + reviewer_approval_rate * 40"
      },
      "depends_on": ["validate_updates", "technical_review", "security_review", "performance_review", "data_review", "stakeholder_review"]
    },
    
    {
      "id": "final_approval",
      "name": "Final Design Approval",
      "type": "human",
      "parameters": {
        "type": "approval",
        "title": "Final Design Approval",
        "description": "Final approval for design implementation",
        "required_skills": ["architecture", "product_management"],
        "priority": 0,
        "timeout_hours": 24,
        "data": {
          "final_design": "{{update_design.output}}",
          "final_score": "{{calculate_final_score.output}}",
          "action_items": "{{consolidate_reviews.output.action_items}}",
          "approved_by": {
            "technical": "{{technical_review.output.approved_by}}",
            "security": "{{security_review.output.approved_by}}",
            "performance": "{{performance_review.output.approved_by}}",
            "data": "{{data_review.output.approved_by}}",
            "stakeholder": "{{stakeholder_review.output.approved_by}}"
          },
          "remaining_concerns": "{{consolidate_reviews.output.unresolved_concerns}}",
          "implementation_plan": "{{input.implementation_plan}}"
        },
        "approval_required": true
      },
      "depends_on": ["calculate_final_score"]
    },
    
    {
      "id": "generate_design_report",
      "name": "Generate Design Review Report",
      "type": "generation",
      "component": null,
      "method": null,
      "parameters": {
        "workflow_name": "design_review_workflow",
        "design_version": "{{input.version}}",
        "review_summary": {
          "overall_score": "{{calculate_final_score.output}}",
          "recommendation": "{{final_approval.output.approved ? 'APPROVED' : 'REJECTED'}}",
          "approvals": "{{final_approval.output.approved_by}}",
          "action_items": "{{consolidate_reviews.output.action_items}}"
        },
        "review_details": {
          "technical": "{{technical_review.output}}",
          "security": "{{security_review.output}}",
          "performance": "{{performance_review.output}}",
          "data": "{{data_review.output}}",
          "stakeholder": "{{stakeholder_review.output}}"
        },
        "design_metrics": {
          "architectural_fitness": "{{validate_design_principles.output.compliance_score}}",
          "scalability_score": "{{analyze_scalability.output.score}}",
          "security_score": "{{analyze_security.output.score}}",
          "data_model_score": "{{analyze_data_model.output.score}}",
          "api_design_score": "{{analyze_api_design.output.score}}"
        },
        "risk_assessment": "{{assess_risks.output}}",
        "trade_off_analysis": "{{identify_trade_offs.output}}",
        "alternatives_evaluation": "{{generate_alternatives_analysis.output}}",
        "output_format": "html",
        "include_diagrams": true
      },
      "depends_on": ["final_approval"],
      "timeout": 180
    },
    
    {
      "id": "archive_design",
      "name": "Archive Design Artifacts",
      "type": "transform",
      "component": null,
      "method": null,
      "parameters": {
        "artifacts": {
          "original_design": "{{receive_design_document.output.design_document}}",
          "final_design": "{{update_design.output}}",
          "review_comments": "{{generate_review_comments.output}}",
          "review_report": "{{generate_design_report.output}}",
          "approvals": "{{final_approval.output.approved_by}}",
          "action_items": "{{consolidate_reviews.output.action_items}}"
        },
        "archive_location": "{{input.archive_path}}/design_reviews/{{input.design_id}}",
        "retention_years": 5,
        "compress": true,
        "version_control": true
      },
      "depends_on": ["generate_design_report"]
    },
    
    {
      "id": "notify_approval",
      "name": "Notify Design Approval",
      "type": "notify",
      "component": null,
      "method": null,
      "parameters": {
        "type": "workflow_completed",
        "message": "Design review completed for {{input.design_id}}",
        "channels": ["slack", "email", "event_bus"],
        "recipients": ["{{input.author}}", "{{input.stakeholders}}", "{{input.reviewers}}"],
        "data": {
          "design_id": "{{input.design_id}}",
          "version": "{{input.version}}",
          "decision": "{{final_approval.output.approved ? 'APPROVED' : 'REJECTED'}}",
          "final_score": "{{calculate_final_score.output}}",
          "report_url": "{{generate_design_report.output.url}}",
          "action_items": "{{consolidate_reviews.output.action_items}}"
        }
      },
      "depends_on": ["generate_design_report"]
    }
  ]
}
