{
  "name": "code_refinement_workflow",
  "version": "2.0",
  "description": "Complete code refinement workflow with iterative improvement, human supervision, validation, and quality assurance",
  
  "variables": {
    "max_iterations": 5,
    "quality_threshold": 85,
    "current_iteration": 0,
    "quality_score": 0,
    "refinement_history": [],
    "change_plan": null
  },
  
  "tasks": [
    {
      "id": "analyze_requirements",
      "name": "Analyze Requirements",
      "type": "analysis",
      "component": "project_scanner",
      "method": "analyze_requirements",
      "parameters": {
        "requirement_file": "{{input.requirement_file}}",
        "context": "{{context}}"
      },
      "timeout": 60
    },
    
    {
      "id": "scan_codebase",
      "name": "Scan Current Codebase",
      "type": "analysis",
      "component": "project_scanner",
      "method": "scan_project",
      "parameters": {
        "project_path": "{{input.project_path}}",
        "recursive": true,
        "include_tests": true
      },
      "depends_on": ["analyze_requirements"]
    },
    
    {
      "id": "analyze_ast",
      "name": "AST Analysis",
      "type": "analysis",
      "component": "ast_analyzer",
      "method": "analyze_file",
      "parameters": {
        "file_path": "{{scan_codebase.output.target_files}}",
        "extract_docstrings": true,
        "extract_complexity": true
      },
      "depends_on": ["scan_codebase"]
    },
    
    {
      "id": "build_import_graph",
      "name": "Build Import Graph",
      "type": "analysis",
      "component": "import_graph",
      "method": "build_graph",
      "parameters": {
        "files": "{{scan_codebase.output.all_files}}",
        "analyze_dependencies": true
      },
      "depends_on": ["scan_codebase"]
    },
    
    {
      "id": "chunk_code",
      "name": "Chunk Code for Analysis",
      "type": "analysis",
      "component": "code_chunker",
      "method": "chunk_by_semantic",
      "parameters": {
        "files": "{{scan_codebase.output.target_files}}",
        "chunk_size": 500,
        "overlap": 50
      },
      "depends_on": ["analyze_ast"]
    },
    
    {
      "id": "create_embeddings",
      "name": "Create Code Embeddings",
      "type": "analysis",
      "component": "batch_encoder",
      "method": "encode_chunks",
      "parameters": {
        "chunks": "{{chunk_code.output.chunks}}",
        "model": "deepseek-coder"
      },
      "depends_on": ["chunk_code"]
    },
    
    {
      "id": "analyze_impact",
      "name": "Analyze Change Impact",
      "type": "refinement",
      "component": "impact_analyzer",
      "method": "analyze_impact",
      "parameters": {
        "requirements": "{{analyze_requirements.output}}",
        "current_code": "{{scan_codebase.output}}",
        "import_graph": "{{build_import_graph.output}}"
      },
      "depends_on": ["analyze_requirements", "scan_codebase", "build_import_graph"]
    },
    
    {
      "id": "generate_change_plan",
      "name": "Generate Change Plan",
      "type": "generation",
      "component": "dependency_planner",
      "method": "create_change_plan",
      "parameters": {
        "impact_analysis": "{{analyze_impact.output}}",
        "requirements": "{{analyze_requirements.output}}",
        "strategy": "minimal_change"
      },
      "depends_on": ["analyze_impact"],
      "timeout": 120
    },
    
    {
      "id": "human_review_change_plan",
      "name": "Human Review: Change Plan",
      "type": "human",
      "parameters": {
        "type": "approval",
        "title": "Review Change Plan",
        "description": "Please review the proposed change plan before implementation",
        "required_skills": ["architecture", "code_review"],
        "priority": 1,
        "timeout_hours": 24,
        "data": {
          "change_plan": "{{generate_change_plan.output}}",
          "impact_summary": "{{analyze_impact.output.summary}}",
          "affected_files": "{{analyze_impact.output.affected_files}}"
        },
        "approval_required": true
      },
      "depends_on": ["generate_change_plan"]
    },
    
    {
      "id": "refine_code_iteration",
      "name": "Refine Code (Iterative)",
      "type": "refinement",
      "component": "iterative_refiner",
      "method": "refine_iteratively",
      "parameters": {
        "change_plan": "{{generate_change_plan.output}}",
        "current_code": "{{scan_codebase.output}}",
        "max_iterations": "{{variables.max_iterations}}",
        "quality_target": "{{variables.quality_threshold}}"
      },
      "depends_on": ["human_review_change_plan"],
      "timeout": 600
    },
    
    {
      "id": "validate_syntax",
      "name": "Validate Syntax",
      "type": "quality",
      "component": "mypy_validator",
      "method": "validate_syntax",
      "parameters": {
        "files": "{{refine_code_iteration.output.modified_files}}",
        "strict": true
      },
      "depends_on": ["refine_code_iteration"]
    },
    
    {
      "id": "run_linter",
      "name": "Run Linter",
      "type": "quality",
      "component": "ruff_validator",
      "method": "lint_files",
      "parameters": {
        "files": "{{refine_code_iteration.output.modified_files}}",
        "fix": true,
        "select_rules": ["E", "F", "W", "C901"]
      },
      "depends_on": ["refine_code_iteration"]
    },
    
    {
      "id": "validate_architecture",
      "name": "Validate Architecture",
      "type": "quality",
      "component": "architecture_validator",
      "method": "validate",
      "parameters": {
        "files": "{{refine_code_iteration.output.modified_files}}",
        "rules": ["layering", "dependency_inversion", "modularity"]
      },
      "depends_on": ["validate_syntax", "run_linter"]
    },
    
    {
      "id": "validate_dependencies",
      "name": "Validate Dependencies",
      "type": "quality",
      "component": "dependency_validator",
      "method": "validate",
      "parameters": {
        "import_graph": "{{build_import_graph.output}}",
        "modified_files": "{{refine_code_iteration.output.modified_files}}",
        "check_cycles": true
      },
      "depends_on": ["validate_architecture"]
    },
    
    {
      "id": "run_tests",
      "name": "Run Unit Tests",
      "type": "quality",
      "component": "test_runner",
      "method": "run_tests",
      "parameters": {
        "test_path": "{{input.test_path}}",
        "target_files": "{{refine_code_iteration.output.modified_files}}",
        "parallel": true,
        "timeout": 300
      },
      "depends_on": ["validate_dependencies"]
    },
    
    {
      "id": "check_coverage",
      "name": "Check Test Coverage",
      "type": "quality",
      "component": "coverage_validator",
      "method": "analyze_coverage",
      "parameters": {
        "files": "{{refine_code_iteration.output.modified_files}}",
        "test_results": "{{run_tests.output}}",
        "min_coverage": 80
      },
      "depends_on": ["run_tests"]
    },
    
    {
      "id": "security_scan",
      "name": "Security Scan",
      "type": "quality",
      "component": "security_validator",
      "method": "scan_code",
      "parameters": {
        "files": "{{refine_code_iteration.output.modified_files}}",
        "rules": ["sql_injection", "xss", "command_injection"]
      },
      "depends_on": ["validate_dependencies"]
    },
    
    {
      "id": "performance_check",
      "name": "Performance Validation",
      "type": "quality",
      "component": "performance_validator",
      "method": "analyze_performance",
      "parameters": {
        "files": "{{refine_code_iteration.output.modified_files}}",
        "complexity_threshold": 10,
        "memory_threshold": 100
      },
      "depends_on": ["validate_dependencies"]
    },
    
    {
      "id": "calculate_quality_score",
      "name": "Calculate Quality Score",
      "type": "transform",
      "component": null,
      "method": null,
      "parameters": {
        "syntax_result": "{{validate_syntax.output}}",
        "linter_result": "{{run_linter.output}}",
        "architecture_result": "{{validate_architecture.output}}",
        "test_result": "{{run_tests.output}}",
        "coverage_result": "{{check_coverage.output}}",
        "security_result": "{{security_scan.output}}",
        "performance_result": "{{performance_check.output}}"
      },
      "depends_on": [
        "validate_syntax",
        "run_linter",
        "validate_architecture",
        "run_tests",
        "check_coverage",
        "security_scan",
        "performance_check"
      ]
    },
    
    {
      "id": "quality_gate_check",
      "name": "Quality Gate Check",
      "type": "condition",
      "component": null,
      "method": null,
      "parameters": {
        "condition": "{{calculate_quality_score.output.score}} >= {{variables.quality_threshold}}"
      },
      "depends_on": ["calculate_quality_score"]
    },
    
    {
      "id": "human_quality_review",
      "name": "Human Quality Review",
      "type": "human",
      "parameters": {
        "type": "review",
        "title": "Quality Review Required",
        "description": "Please review the refined code quality",
        "required_skills": ["code_review", "quality_assurance"],
        "priority": 1,
        "timeout_hours": 24,
        "data": {
          "quality_report": "{{calculate_quality_score.output}}",
          "modified_files": "{{refine_code_iteration.output.modified_files}}",
          "test_results": "{{run_tests.output}}",
          "security_issues": "{{security_scan.output.issues}}"
        }
      },
      "depends_on": ["calculate_quality_score"]
    },
    
    {
      "id": "iteration_decision",
      "name": "Iteration Decision",
      "type": "condition",
      "component": null,
      "method": null,
      "parameters": {
        "condition": "{{quality_gate_check.output}} == true or {{variables.current_iteration}} >= {{variables.max_iterations}}"
      },
      "depends_on": ["quality_gate_check", "human_quality_review"]
    },
    
    {
      "id": "update_refinement_history",
      "name": "Update Refinement History",
      "type": "transform",
      "component": null,
      "method": null,
      "parameters": {
        "iteration": "{{variables.current_iteration}}",
        "quality_score": "{{calculate_quality_score.output.score}}",
        "changes": "{{refine_code_iteration.output.changes}}",
        "timestamp": "{{context.current_time}}"
      },
      "depends_on": ["calculate_quality_score"]
    },
    
    {
      "id": "increment_iteration",
      "name": "Increment Iteration Counter",
      "type": "transform",
      "component": null,
      "method": null,
      "parameters": {
        "operation": "increment",
        "variable": "current_iteration"
      },
      "depends_on": ["update_refinement_history"]
    },
    
    {
      "id": "continue_refinement",
      "name": "Continue Refinement Loop",
      "type": "condition",
      "component": null,
      "method": null,
      "parameters": {
        "condition": "{{iteration_decision.output}} == false and {{variables.current_iteration}} < {{variables.max_iterations}}"
      },
      "depends_on": ["iteration_decision", "increment_iteration"]
    },
    
    {
      "id": "apply_improvements",
      "name": "Apply Improvements",
      "type": "refinement",
      "component": "feedback_loop",
      "method": "apply_feedback",
      "parameters": {
        "feedback": "{{human_quality_review.output.feedback}}",
        "current_code": "{{refine_code_iteration.output}}",
        "quality_issues": "{{calculate_quality_score.output.issues}}"
      },
      "depends_on": ["continue_refinement"],
      "condition": "{{continue_refinement.output}} == true"
    },
    
    {
      "id": "loop_back",
      "name": "Loop Back to Refinement",
      "type": "transform",
      "component": null,
      "method": null,
      "parameters": {
        "goto": "refine_code_iteration",
        "updated_code": "{{apply_improvements.output}}"
      },
      "depends_on": ["apply_improvements"]
    },
    
    {
      "id": "generate_documentation",
      "name": "Generate Documentation",
      "type": "generation",
      "component": "docstring_generator",
      "method": "generate_docstrings",
      "parameters": {
        "files": "{{refine_code_iteration.output.modified_files}}",
        "style": "google",
        "update_existing": true
      },
      "depends_on": ["iteration_decision"],
      "condition": "{{iteration_decision.output}} == true"
    },
    
    {
      "id": "update_changelog",
      "name": "Update Changelog",
      "type": "generation",
      "component": null,
      "method": null,
      "parameters": {
        "refinement_history": "{{update_refinement_history.output}}",
        "version": "{{input.new_version}}",
        "changes_summary": "{{refine_code_iteration.output.summary}}"
      },
      "depends_on": ["generate_documentation"]
    },
    
    {
      "id": "create_git_commit",
      "name": "Create Git Commit",
      "type": "function",
      "component": "git_utils",
      "method": "commit_changes",
      "parameters": {
        "files": "{{refine_code_iteration.output.modified_files}}",
        "message": "Refinement: {{refine_code_iteration.output.summary}}",
        "create_branch": true,
        "branch_name": "refinement/{{input.branch_name}}"
      },
      "depends_on": ["update_changelog"]
    },
    
    {
      "id": "human_final_approval",
      "name": "Human Final Approval",
      "type": "human",
      "parameters": {
        "type": "approval",
        "title": "Final Approval for Refinement",
        "description": "Please approve the final refined code",
        "required_skills": ["architecture", "code_review", "security"],
        "priority": 0,
        "timeout_hours": 48,
        "data": {
          "final_quality_score": "{{calculate_quality_score.output.score}}",
          "summary": "{{refine_code_iteration.output.summary}}",
          "commit_id": "{{create_git_commit.output.commit_id}}",
          "test_results": "{{run_tests.output}}",
          "security_scan": "{{security_scan.output}}",
          "coverage": "{{check_coverage.output}}"
        },
        "approval_required": true
      },
      "depends_on": ["create_git_commit"]
    },
    
    {
      "id": "generate_report",
      "name": "Generate Refinement Report",
      "type": "generation",
      "component": null,
      "method": null,
      "parameters": {
        "workflow_name": "code_refinement_workflow",
        "iterations": "{{variables.current_iteration}}",
        "final_quality": "{{calculate_quality_score.output}}",
        "history": "{{update_refinement_history.output}}",
        "changes": "{{refine_code_iteration.output}}",
        "human_approvals": {
          "change_plan": "{{human_review_change_plan.output}}",
          "quality_review": "{{human_quality_review.output}}",
          "final_approval": "{{human_final_approval.output}}"
        },
        "timestamps": {
          "started": "{{context.start_time}}",
          "completed": "{{context.current_time}}"
        }
      },
      "depends_on": ["human_final_approval"]
    },
    
    {
      "id": "notify_completion",
      "name": "Notify Completion",
      "type": "notify",
      "component": null,
      "method": null,
      "parameters": {
        "type": "workflow_completed",
        "message": "Code refinement completed successfully",
        "channels": ["log", "event_bus"],
        "data": {
          "workflow": "code_refinement_workflow",
          "result": "{{generate_report.output}}",
          "status": "success"
        }
      },
      "depends_on": ["generate_report"]
    }
  ]
}